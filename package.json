{
  "name": "dns-pulse-workspace",
  "private": true,
  "version": "2.1.0",
  "workspaces": [
    "tools/web-studio"
  ],
  "scripts": {
    "dev": "PATH=./tools/web-studio/node_modules/.bin:./node_modules/.bin:$PATH exec tsx tools/web-studio/server.ts",
    "start": "PATH=./tools/web-studio/node_modules/.bin:./node_modules/.bin:$PATH exec tsx tools/web-studio/server.ts",
    "build": "npm --prefix tools/web-studio run build",
    "preview": "npm --prefix tools/web-studio run preview",
    "lint": "npm --prefix tools/web-studio run lint",
    "test": "npm --prefix tools/web-studio run test"
  }
}
