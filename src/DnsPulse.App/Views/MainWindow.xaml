<ui:FluentWindow x:Class="DnsPulse.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:DnsPulse.App.Views"
                 xmlns:conv="clr-namespace:DnsPulse.App.Converters"
                 Title="{Binding WindowTitle}"
                 FlowDirection="{Binding Localization.FlowDirection}"
                 Width="1200"
                 Height="780"
                 MinWidth="880"
                 MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="{Binding WindowTitle}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
      </ui:TitleBar.Icon>
      <ui:TitleBar.TrailingContent>
        <ui:Button Margin="0,0,8,0"
                   Padding="10,4"
                   Appearance="Secondary"
                   WindowChrome.IsHitTestVisibleInChrome="True"
                   Command="{Binding RestoreDismissedBannersCommand}"
                   Visibility="{Binding HasDismissedBanners, Converter={StaticResource BooleanToVisibilityConverter}}"
                   AutomationProperties.Name="{conv:Localization Banner_ShowNotifications}"
                   AutomationProperties.HelpText="{conv:Localization Banner_ShowNotifications}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Alert24" FontSize="14" Margin="0,0,6,0" />
            <TextBlock Text="{conv:Localization Banner_ShowNotifications}"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <Border Margin="6,0,0,0"
                    Padding="6,1"
                    CornerRadius="10"
                    Background="#B45309">
              <TextBlock Text="{Binding DismissedBannerCount}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="White"
                         VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </ui:Button>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <!-- Collapsible Proactive Advisory Notification Cards -->
    <StackPanel Grid.Row="1" Margin="12,4,12,0">
      <!-- Dirty Recovery Banner -->
      <Border Margin="0,0,0,4"
              Padding="12,7"
              CornerRadius="8"
              Background="#1C212A"
              BorderBrush="#D97706"
              BorderThickness="1"
              Visibility="{Binding ShowDirtyRecoveryBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{conv:Localization Banner_DirtyRecovery_Title}"
              AutomationProperties.HelpText="{Binding DirtyRecoverySummary}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="24"
                  Height="24"
                  CornerRadius="12"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Background="#B45309">
            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="White" />
          </Border>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="#F8FAFC"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding DirtyRecoverySummary}">
            <Run FontWeight="SemiBold" Text="{conv:Localization Banner_DirtyRecovery_Title}" />
            <Run Text=" — " Foreground="#94A3B8" />
            <Run Text="{Binding DirtyRecoverySummary, Mode=OneWay}" Foreground="#CBD5E1" />
          </TextBlock>
          <ui:Button Grid.Column="2"
                     Margin="8,0,0,0"
                     Padding="7,3"
                     Appearance="Secondary"
                     Content="×"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Command="{Binding DismissDirtyRecoveryBannerCommand}"
                     ToolTip="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.Name="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.HelpText="{conv:Localization Banner_DirtyRecovery_Title}" />
        </Grid>
      </Border>

      <!-- Browser DoH Bypass Banner -->
      <Border Margin="0,0,0,4"
              Padding="12,7"
              CornerRadius="8"
              Background="#1C212A"
              BorderBrush="#D97706"
              BorderThickness="1"
              Visibility="{Binding ShowBrowserDohBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{conv:Localization Banner_BrowserDoh_Title}"
              AutomationProperties.HelpText="{Binding BrowserDohBannerMessage}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="24"
                  Height="24"
                  CornerRadius="12"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Background="#B45309">
            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="White" />
          </Border>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="#F8FAFC"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding BrowserDohBannerMessage}">
            <Run FontWeight="SemiBold" Text="{conv:Localization Banner_BrowserDoh_Title}" />
            <Run Text=" — " Foreground="#94A3B8" />
            <Run Text="{Binding BrowserDohBannerMessage, Mode=OneWay}" Foreground="#CBD5E1" />
          </TextBlock>
          <ui:Button Grid.Column="2"
                     Margin="10,0,0,0"
                     Padding="10,4"
                     Appearance="Primary"
                     FontSize="12"
                     Content="{conv:Localization Banner_BrowserDoh_Fix}"
                     Command="{Binding FixBrowserDohCommand}"
                     AutomationProperties.Name="{conv:Localization Banner_BrowserDoh_Fix}"
                     AutomationProperties.HelpText="{Binding BrowserDohBannerMessage}" />
          <ui:Button Grid.Column="3"
                     Margin="6,0,0,0"
                     Padding="7,3"
                     Appearance="Secondary"
                     Content="×"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Command="{Binding DismissBrowserDohBannerCommand}"
                     ToolTip="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.Name="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.HelpText="{conv:Localization Banner_BrowserDoh_Title}" />
        </Grid>
      </Border>

      <!-- Port 53 Conflict Banner -->
      <Border Margin="0,0,0,4"
              Padding="12,7"
              CornerRadius="8"
              Background="#1C212A"
              BorderBrush="#D97706"
              BorderThickness="1"
              Visibility="{Binding ShowPort53ConflictBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{conv:Localization Banner_Port53_Title}"
              AutomationProperties.HelpText="{Binding Port53ConflictBannerMessage}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="24"
                  Height="24"
                  CornerRadius="12"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Background="#B45309">
            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="White" />
          </Border>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="#F8FAFC"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Port53ConflictBannerMessage}">
            <Run FontWeight="SemiBold" Text="{conv:Localization Banner_Port53_Title}" />
            <Run Text=" — " Foreground="#94A3B8" />
            <Run Text="{Binding Port53ConflictBannerMessage, Mode=OneWay}" Foreground="#CBD5E1" />
          </TextBlock>
          <ui:Button Grid.Column="2"
                     Margin="10,0,0,0"
                     Padding="10,4"
                     Appearance="Primary"
                     FontSize="12"
                     Content="{conv:Localization Banner_Port53_Fix}"
                     Command="{Binding FixPort53ConflictCommand}"
                     AutomationProperties.Name="{conv:Localization Banner_Port53_Fix}"
                     AutomationProperties.HelpText="{Binding Port53ConflictBannerMessage}" />
          <ui:Button Grid.Column="3"
                     Margin="6,0,0,0"
                     Padding="7,3"
                     Appearance="Secondary"
                     Content="×"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Command="{Binding DismissPort53ConflictBannerCommand}"
                     ToolTip="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.Name="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.HelpText="{conv:Localization Banner_Port53_Title}" />
        </Grid>
      </Border>

      <!-- Multi-Network / VPN Advisory Banner -->
      <Border Margin="0,0,0,4"
              Padding="12,7"
              CornerRadius="8"
              Background="#1C212A"
              BorderBrush="#2563EB"
              BorderThickness="1"
              Visibility="{Binding ShowVpnAdvisoryBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{conv:Localization Banner_VpnAdvisory_Title}"
              AutomationProperties.HelpText="{conv:Localization Banner_VpnAdvisory_Desc}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="24"
                  Height="24"
                  CornerRadius="12"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Background="#1D4ED8">
            <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="White" />
          </Border>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="#F8FAFC"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{conv:Localization Banner_VpnAdvisory_Desc}">
            <Run FontWeight="SemiBold" Text="{conv:Localization Banner_VpnAdvisory_Title}" />
            <Run Text=" — " Foreground="#94A3B8" />
            <Run Text="{conv:Localization Banner_VpnAdvisory_Desc}" Foreground="#CBD5E1" />
          </TextBlock>
          <ui:Button Grid.Column="2"
                     Margin="8,0,0,0"
                     Padding="7,3"
                     Appearance="Secondary"
                     Content="×"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Command="{Binding DismissVpnAdvisoryBannerCommand}"
                     ToolTip="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.Name="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.HelpText="{conv:Localization Banner_VpnAdvisory_Title}" />
        </Grid>
      </Border>

      <!-- Anti-Cheat Driver Advisory Banner -->
      <Border Margin="0,0,0,4"
              Padding="12,7"
              CornerRadius="8"
              Background="#1C212A"
              BorderBrush="#DC2626"
              BorderThickness="1"
              Visibility="{Binding ShowAntiCheatBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{conv:Localization Banner_AntiCheat_Title}"
              AutomationProperties.HelpText="{Binding AntiCheatBannerMessage}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="24"
                  Height="24"
                  CornerRadius="12"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Background="#B91C1C">
            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Foreground="White" />
          </Border>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     Foreground="#F8FAFC"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding AntiCheatBannerMessage}">
            <Run FontWeight="SemiBold" Text="{conv:Localization Banner_AntiCheat_Title}" />
            <Run Text=" — " Foreground="#94A3B8" />
            <Run Text="{Binding AntiCheatBannerMessage, Mode=OneWay}" Foreground="#CBD5E1" />
          </TextBlock>
          <ui:Button Grid.Column="2"
                     Margin="8,0,0,0"
                     Padding="7,3"
                     Appearance="Secondary"
                     Content="×"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Command="{Binding DismissAntiCheatBannerCommand}"
                     ToolTip="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.Name="{conv:Localization Banner_Dismiss}"
                     AutomationProperties.HelpText="{conv:Localization Banner_AntiCheat_Title}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- 5-Page Fluent 2 Navigation Shell -->
    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="2"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True"
                       OpenPaneLength="236"
                       CompactPaneLength="52"
                       Navigated="OnNavigationNavigated">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="{Binding NavigationItems[0].Title}"
                               TargetPageTag="Overview"
                               TargetPageType="{x:Type views:OverviewPage}"
                               AutomationProperties.Name="{Binding NavigationItems[0].AutomationName}"
                               AutomationProperties.HelpText="{Binding NavigationItems[0].AutomationName}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="ShieldCheckmark24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="{Binding NavigationItems[1].Title}"
                               TargetPageTag="Routing"
                               TargetPageType="{x:Type views:RoutingInspectorPage}"
                               AutomationProperties.Name="{Binding NavigationItems[1].AutomationName}"
                               AutomationProperties.HelpText="{Binding NavigationItems[1].AutomationName}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="BranchFork24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="{Binding NavigationItems[2].Title}"
                               TargetPageTag="Servers"
                               TargetPageType="{x:Type views:ServersCatalogPage}"
                               AutomationProperties.Name="{Binding NavigationItems[2].AutomationName}"
                               AutomationProperties.HelpText="{Binding NavigationItems[2].AutomationName}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Server24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem Content="{Binding NavigationItems[3].Title}"
                               TargetPageTag="Diagnostics"
                               TargetPageType="{x:Type views:DiagnosticsDoctorPage}"
                               AutomationProperties.Name="{Binding NavigationItems[3].AutomationName}"
                               AutomationProperties.HelpText="{Binding NavigationItems[3].AutomationName}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Stethoscope24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="{Binding NavigationItems[4].Title}"
                               TargetPageTag="Settings"
                               TargetPageType="{x:Type views:SettingsSafetyPage}"
                               AutomationProperties.Name="{Binding NavigationItems[4].AutomationName}"
                               AutomationProperties.HelpText="{Binding NavigationItems[4].AutomationName}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Settings24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
