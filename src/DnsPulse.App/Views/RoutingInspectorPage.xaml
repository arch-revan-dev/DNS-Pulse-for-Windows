<UserControl x:Class="DnsPulse.App.Views.RoutingInspectorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DnsPulse.App.ViewModels"
             xmlns:behaviors="clr-namespace:DnsPulse.App.Behaviors"
             xmlns:conv="clr-namespace:DnsPulse.App.Converters">
  <UserControl.Resources>
    <DataTemplate x:Key="TelemetryRowTemplate">
      <Border Padding="12,8"
              Margin="0,0,0,5"
              CornerRadius="8"
              Background="{DynamicResource PulseInnerPanelBrush}"
              BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="1.3*" />
          </Grid.ColumnDefinitions>

          <!-- Time -->
          <TextBlock Grid.Column="0"
                     FontSize="11"
                     FontFamily="Consolas"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     VerticalAlignment="Center"
                     Text="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" />

          <!-- Domain + Record Type -->
          <Grid Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding Domain}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Domain}" />
            <Border Grid.Column="1"
                    Margin="6,0,0,0"
                    Padding="5,1"
                    CornerRadius="4"
                    Background="{DynamicResource PulseChipSurfaceBrush}"
                    VerticalAlignment="Center">
              <TextBlock FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         Text="{Binding RecordType}" />
            </Border>
          </Grid>

          <!-- Localized Zone -->
          <Border Grid.Column="2"
                  Margin="0,0,8,0"
                  Padding="7,2"
                  CornerRadius="8"
                  Background="{DynamicResource PulseChipSurfaceBrush}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       TextTrimming="CharacterEllipsis">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource EnumLocalizationConverter}">
                  <Binding Path="Zone" />
                  <Binding Path="[App_Title]" Source="{x:Static conv:LocalizationSource.Instance}" />
                </MultiBinding>
              </TextBlock.Text>
              <TextBlock.ToolTip>
                <MultiBinding Converter="{StaticResource EnumLocalizationConverter}">
                  <Binding Path="Zone" />
                  <Binding Path="[App_Title]" Source="{x:Static conv:LocalizationSource.Instance}" />
                </MultiBinding>
              </TextBlock.ToolTip>
            </TextBlock>
          </Border>

          <!-- Upstream + Protocol -->
          <Grid Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding UpstreamName}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding UpstreamName}" />
            <Border Grid.Column="1"
                    Margin="5,0,0,0"
                    Padding="5,1"
                    CornerRadius="4"
                    Background="{DynamicResource PulseProtocolBadgeBgBrush}"
                    VerticalAlignment="Center">
              <TextBlock FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource PulseProtocolBadgeFgBrush}"
                         Text="{Binding Protocol}" />
            </Border>
          </Grid>

          <!-- Latency -->
          <TextBlock Grid.Column="4"
                     Margin="0,0,8,0"
                     FontSize="11"
                     FontFamily="Consolas"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Text="{Binding LatencyMs, Converter={StaticResource LatencyFormatConverter}}" />

          <!-- Localized ResponseCode -->
          <TextBlock Grid.Column="5"
                     Margin="0,0,8,0"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource EnumLocalizationConverter}">
                <Binding Path="ResponseCode" />
                <Binding Path="[App_Title]" Source="{x:Static conv:LocalizationSource.Instance}" />
              </MultiBinding>
            </TextBlock.Text>
            <TextBlock.ToolTip>
              <MultiBinding Converter="{StaticResource EnumLocalizationConverter}">
                <Binding Path="ResponseCode" />
                <Binding Path="[App_Title]" Source="{x:Static conv:LocalizationSource.Instance}" />
              </MultiBinding>
            </TextBlock.ToolTip>
          </TextBlock>

          <!-- Decision Note -->
          <TextBlock Grid.Column="6"
                     FontSize="11"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     VerticalAlignment="Center"
                     Text="{Binding DecisionNote}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding DecisionNote}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="{DynamicResource PulsePagePadding}" MaxWidth="1320">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Page Header + Clean Segmented Sub-Tab Switcher -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="{conv:Localization Routing_Page_Title}" />
        <TextBlock Margin="0,3,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{conv:Localization Routing_Page_Subtitle}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Column="1"
              Padding="4"
              CornerRadius="11"
              VerticalAlignment="Center"
              Background="{DynamicResource PulseSegmentTrackBrush}"
              BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
              BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <RadioButton GroupName="RoutingSubTabs"
                       Style="{StaticResource PulseIosSegmentRadioStyle}"
                       Command="{Binding SelectSubTabCommand}"
                       IsChecked="{Binding IsServicesTabSelected, Mode=OneWay}"
                       AutomationProperties.Name="{conv:Localization Routing_SubTab_Services}">
            <RadioButton.CommandParameter>
              <sys:Int32>0</sys:Int32>
            </RadioButton.CommandParameter>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{conv:Localization Routing_SubTab_Services}" VerticalAlignment="Center" />
              <Border Margin="7,0,0,0"
                      Padding="6,1"
                      CornerRadius="9"
                      Background="{DynamicResource PulseCountBadgeBgBrush}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding EnabledPresetsCount}" />
              </Border>
            </StackPanel>
          </RadioButton>

          <RadioButton GroupName="RoutingSubTabs"
                       Style="{StaticResource PulseIosSegmentRadioStyle}"
                       Command="{Binding SelectSubTabCommand}"
                       IsChecked="{Binding IsLogTabSelected, Mode=OneWay}"
                       AutomationProperties.Name="{conv:Localization Routing_SubTab_Log}">
            <RadioButton.CommandParameter>
              <sys:Int32>1</sys:Int32>
            </RadioButton.CommandParameter>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{conv:Localization Routing_SubTab_Log}" VerticalAlignment="Center" />
              <Border Margin="7,0,0,0"
                      Padding="6,1"
                      CornerRadius="9"
                      Background="{DynamicResource PulseCountBadgeBgBrush}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding TotalQueriesCount}" />
              </Border>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>
    </Grid>

    <!-- SUB-TAB 0: Rich 2-Column Service Cards + GitHub Domain/IP Repos + Collapsible Custom Rules -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Visibility="{Binding IsServicesTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <!-- Rich 2-Column Service Toggle Grid -->
        <TextBlock Margin="2,0,0,10"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="{conv:Localization Routing_Presets_Title}" />

        <ItemsControl ItemsSource="{Binding ServicePresets}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,10,10"
                      Padding="16,14"
                      CornerRadius="12"
                      Background="{DynamicResource PulseGlassCardBrush}"
                      BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                      BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="{Binding DisplayName}"
                                 VerticalAlignment="Center" />
                      <Border Margin="8,0,0,0"
                              Padding="7,2"
                              CornerRadius="9"
                              Background="{DynamicResource PulseChipSurfaceBrush}"
                              VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding DomainCount}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding Description}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Description}" />
                  </StackPanel>

                  <ui:ToggleSwitch Grid.Column="1"
                                   VerticalAlignment="Center"
                                   IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding DisplayName}"
                                   AutomationProperties.HelpText="{conv:Localization Routing_Presets_Title}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- GitHub Public Domain & IP Subnet Repositories Loader -->
        <Border Margin="0,0,10,14"
                Padding="18"
                CornerRadius="14"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Margin="0,0,8,0"
                        Padding="9,4"
                        CornerRadius="10"
                        Background="{DynamicResource PulseProtocolBadgeBgBrush}">
                  <TextBlock FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource PulseProtocolBadgeFgBrush}">
                    <Run Text="{conv:Localization Routing_Repos_DomainsBadge}" />
                    <Run Text=": " />
                    <Run Text="{Binding CustomGeoUnlockDomains.Count, Mode=OneWay}" />
                  </TextBlock>
                </Border>
                <Border Padding="9,4"
                        CornerRadius="10"
                        Background="{DynamicResource PulseChipSurfaceBrush}">
                  <TextBlock FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Run Text="{conv:Localization Routing_Repos_IpsBadge}" />
                    <Run Text=": " />
                    <Run Text="{Binding ImportedIpRangesCount, Mode=OneWay}" />
                  </TextBlock>
                </Border>
              </StackPanel>

              <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{conv:Localization Routing_Repos_Title}" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{conv:Localization Routing_Repos_Subtitle}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0"
                          Margin="0,0,10,0"
                          PlaceholderText="{conv:Localization Routing_Repos_UrlPlaceholder}"
                          Text="{Binding CustomRepoUrlInput, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{conv:Localization Routing_Repos_Title}" />
              <ui:Button Grid.Column="1"
                         Padding="16,8"
                         Appearance="Primary"
                         Content="{conv:Localization Routing_Repos_SyncButton}"
                         Command="{Binding SyncDomainAndIpReposCommand}"
                         IsEnabled="{Binding IsSyncingDomainRepos, Converter={StaticResource InverseBoolConverter}}"
                         AutomationProperties.Name="{conv:Localization Routing_Repos_SyncButton}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="CloudArrowDown24" />
                </ui:Button.Icon>
              </ui:Button>
            </Grid>

            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource PulseIosGreenBrush}"
                       Text="{Binding DomainRepoSyncStatus}"
                       TextWrapping="Wrap"
                       Visibility="{Binding DomainRepoSyncStatus, Converter={StaticResource NullToVisibilityConverter}}" />
          </StackPanel>
        </Border>

        <!-- Collapsible Custom Rules Import / Export -->
        <ui:CardExpander Header="{conv:Localization Routing_Rules_Title}"
                         Margin="0,0,10,8">
          <ui:CardExpander.Icon>
            <ui:SymbolIcon Symbol="DocumentEdit24" />
          </ui:CardExpander.Icon>
          <StackPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,4"
                       Text="{conv:Localization Routing_Rules_Format}" />
            <ComboBox Width="260"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding AvailableRuleFormats}"
                      SelectedItem="{Binding SelectedRuleFormat, Mode=TwoWay}"
                      Margin="0,0,0,10"
                      AutomationProperties.Name="{conv:Localization Routing_Rules_Format}"
                      AutomationProperties.HelpText="{conv:Localization Routing_Rules_Title}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource EnumLocalizationConverter}">
                        <Binding />
                        <Binding Path="[App_Title]" Source="{x:Static conv:LocalizationSource.Instance}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <ui:TextBox MinHeight="110"
                        MaxHeight="200"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        Text="{Binding CustomRulesInputText, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,12"
                        AutomationProperties.Name="{conv:Localization Routing_Rules_Title}"
                        AutomationProperties.HelpText="{conv:Localization Routing_Rules_Format}" />

            <WrapPanel Orientation="Horizontal">
              <ui:Button Margin="0,0,8,8"
                         Appearance="Primary"
                         Content="{conv:Localization Routing_Rules_Import}"
                         Command="{Binding ImportRulesCommand}"
                         AutomationProperties.Name="{conv:Localization Routing_Rules_Import}"
                         AutomationProperties.HelpText="{conv:Localization Routing_Rules_Title}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="ArrowDownload24" />
                </ui:Button.Icon>
              </ui:Button>
              <ui:Button Margin="0,0,0,8"
                         Content="{conv:Localization Routing_Rules_Export}"
                         Command="{Binding ExportRulesCommand}"
                         AutomationProperties.Name="{conv:Localization Routing_Rules_Export}"
                         AutomationProperties.HelpText="{conv:Localization Routing_Rules_Title}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="ArrowUpload24" />
                </ui:Button.Icon>
              </ui:Button>
            </WrapPanel>

            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="{Binding RuleImportStatusMessage}"
                       TextWrapping="Wrap"
                       Visibility="{Binding RuleImportStatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <!-- SUB-TAB 1: Full-Width Live Query Log with KPI Strip & Helpful Empty State -->
    <Grid Grid.Row="1"
          Visibility="{Binding IsLogTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 4 Live Telemetry KPI Cards -->
      <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
        <Border Margin="0,0,10,0"
                Padding="14,12"
                CornerRadius="12"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Kpi_Total}" />
            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding TotalQueriesCount}" />
          </StackPanel>
        </Border>

        <Border Margin="0,0,10,0"
                Padding="14,12"
                CornerRadius="12"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Kpi_GeoUnlocked}" />
            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PulseIosGreenBrush}" Text="{Binding GeoUnlockedQueriesCount}" />
          </StackPanel>
        </Border>

        <Border Margin="0,0,10,0"
                Padding="14,12"
                CornerRadius="12"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Kpi_Blocked}" />
            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PulseWarningBrush}" Text="{Binding BlockedQueriesCount}" />
          </StackPanel>
        </Border>

        <Border Padding="14,12"
                CornerRadius="12"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Kpi_AvgLatency}" />
            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PulseIosBlueBrush}" Text="{Binding AverageLatencyMsText}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Search + Filter Chips + Clear Toolbar -->
      <Border Grid.Row="1"
              Margin="0,0,0,10"
              Padding="14,12"
              CornerRadius="12"
              Background="{DynamicResource PulseGlassCardBrush}"
              BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
              BorderThickness="1">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        Margin="0,0,10,0"
                        PlaceholderText="{conv:Localization Routing_Search_Placeholder}"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Auto_SearchInput}"
                        AutomationProperties.HelpText="{conv:Localization Routing_Search_Placeholder}">
              <ui:TextBox.Icon>
                <ui:SymbolIcon Symbol="Search24" />
              </ui:TextBox.Icon>
            </ui:TextBox>
            <ui:Button Grid.Column="1"
                       Content="{conv:Localization Routing_Telemetry_Clear}"
                       Command="{Binding ClearTelemetryCommand}"
                       AutomationProperties.Name="{conv:Localization Routing_Telemetry_Clear}"
                       AutomationProperties.HelpText="{conv:Localization Routing_Telemetry_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Delete24" />
              </ui:Button.Icon>
            </ui:Button>
          </Grid>

          <WrapPanel Orientation="Horizontal">
            <RadioButton GroupName="RoutingFilterChips"
                         Style="{StaticResource PulseFilterChipStyle}"
                         Content="{conv:Localization Routing_Chip_All}"
                         Command="{Binding SelectFilterChipCommand}"
                         CommandParameter="{x:Static vm:TelemetryFilterChip.All}"
                         IsChecked="{Binding SelectedFilterChip, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:TelemetryFilterChip.All}, Mode=OneWay}"
                         AutomationProperties.Name="{conv:Localization Routing_Chip_All}"
                         AutomationProperties.HelpText="{conv:Localization Routing_Telemetry_Title}" />
            <RadioButton GroupName="RoutingFilterChips"
                         Style="{StaticResource PulseFilterChipStyle}"
                         Content="{conv:Localization Routing_Chip_GeoUnlocked}"
                         Command="{Binding SelectFilterChipCommand}"
                         CommandParameter="{x:Static vm:TelemetryFilterChip.GeoUnlocked}"
                         IsChecked="{Binding SelectedFilterChip, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:TelemetryFilterChip.GeoUnlocked}, Mode=OneWay}"
                         AutomationProperties.Name="{conv:Localization Routing_Chip_GeoUnlocked}"
                         AutomationProperties.HelpText="{conv:Localization Routing_Telemetry_Title}" />
            <RadioButton GroupName="RoutingFilterChips"
                         Style="{StaticResource PulseFilterChipStyle}"
                         Content="{conv:Localization Routing_Chip_DpiSplit}"
                         Command="{Binding SelectFilterChipCommand}"
                         CommandParameter="{x:Static vm:TelemetryFilterChip.DpiSplit}"
                         IsChecked="{Binding SelectedFilterChip, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:TelemetryFilterChip.DpiSplit}, Mode=OneWay}"
                         AutomationProperties.Name="{conv:Localization Routing_Chip_DpiSplit}"
                         AutomationProperties.HelpText="{conv:Localization Routing_Telemetry_Title}" />
            <RadioButton GroupName="RoutingFilterChips"
                         Style="{StaticResource PulseFilterChipStyle}"
                         Content="{conv:Localization Routing_Chip_Blocked}"
                         Command="{Binding SelectFilterChipCommand}"
                         CommandParameter="{x:Static vm:TelemetryFilterChip.Blocked}"
                         IsChecked="{Binding SelectedFilterChip, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:TelemetryFilterChip.Blocked}, Mode=OneWay}"
                         AutomationProperties.Name="{conv:Localization Routing_Chip_Blocked}"
                         AutomationProperties.HelpText="{conv:Localization Routing_Telemetry_Title}" />
            <RadioButton GroupName="RoutingFilterChips"
                         Style="{StaticResource PulseFilterChipStyle}"
                         Content="{conv:Localization Routing_Chip_Errors}"
                         Command="{Binding SelectFilterChipCommand}"
                         CommandParameter="{x:Static vm:TelemetryFilterChip.Errors}"
                         IsChecked="{Binding SelectedFilterChip, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter={x:Static vm:TelemetryFilterChip.Errors}, Mode=OneWay}"
                         AutomationProperties.Name="{conv:Localization Routing_Chip_Errors}"
                         AutomationProperties.HelpText="{conv:Localization Routing_Telemetry_Title}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Responsive Column Header Row -->
      <Border Grid.Row="2"
              Padding="12,8"
              Margin="0,0,0,6"
              CornerRadius="8"
              Background="{DynamicResource PulseHeaderSurfaceBrush}"
              BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="1.3*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Col_Time}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Margin="6,0,8,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Col_Domain}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Col_Zone}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Col_Upstream}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="4" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" Text="{conv:Localization Routing_Col_Latency}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="5" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Col_Result}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{conv:Localization Routing_Col_Note}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

      <!-- Full-Width Virtualized Smooth-Scrolled Telemetry ListView + Empty State -->
      <Grid Grid.Row="3">
        <ListView Style="{StaticResource PulseDarkCardListViewStyle}"
                  ItemContainerStyle="{StaticResource PulseDarkListViewItemStyle}"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  ItemsSource="{Binding FilteredTelemetryEvents}"
                  ItemTemplate="{StaticResource TelemetryRowTemplate}"
                  AutomationProperties.Name="{conv:Localization Routing_Telemetry_Title}" />

        <Border Padding="28"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="460"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1"
                Visibility="{Binding IsLogEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Pulse24"
                           FontSize="32"
                           Foreground="{DynamicResource PulseIosBlueBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
            <TextBlock FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{conv:Localization Routing_Log_EmptyTitle}" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{conv:Localization Routing_Log_EmptySubtitle}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
