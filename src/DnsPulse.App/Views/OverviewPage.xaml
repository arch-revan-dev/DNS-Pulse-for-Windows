<UserControl x:Class="DnsPulse.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:DnsPulse.App.Converters">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PulsePagePadding}">
    <StackPanel MaxWidth="1280">
      <!-- SIMPLE MODE ("Для чайников"): One-Button AI Autopilot + Desktop AI Apps Capture -->
      <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ui:Card Padding="28"
                 Margin="{DynamicResource PulseSectionMargin}">
          <StackPanel HorizontalAlignment="Center" MaxWidth="680">
            <Border Width="64"
                    Height="64"
                    CornerRadius="32"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14"
                    Background="{Binding HeroState, Converter={StaticResource VerdictToBrushConverter}}">
              <ui:SymbolIcon Symbol="ShieldCheckmark24"
                             FontSize="30"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Border>

            <ui:TextBlock FontTypography="TitleLarge"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          Text="{conv:Localization Simple_Title}" />

            <TextBlock Margin="0,6,0,18"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{conv:Localization Simple_Subtitle}" />

            <!-- THE ONE BIG BUTTON -->
            <ui:Button HorizontalAlignment="Center"
                       MinWidth="260"
                       Height="54"
                       Padding="28,12"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Appearance="Primary"
                       Content="{Binding SimplePrimaryButtonText}"
                       Command="{Binding ToggleAiAutopilotCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Flash24" FontSize="20" />
              </ui:Button.Icon>
            </ui:Button>

            <!-- Live Autopilot Progress -->
            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding IsAutoFinding, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ProgressBar Height="6"
                           Minimum="0"
                           Maximum="100"
                           Value="{Binding AutoSetupProgress}" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="{Binding AutoSetupStepMessage}" />
            </StackPanel>

            <!-- Live Status & Dynamic Watchdog Summary -->
            <Border Margin="0,16,0,0"
                    Padding="14,10"
                    CornerRadius="8"
                    Background="{DynamicResource PulseInnerPanelBrush}"
                    BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
                    BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding HeroStatusTitle}" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding LocalProxyEndpointText}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           TextAlignment="Center"
                           Foreground="{StaticResource PulseSuccessBrush}"
                           Text="{Binding WatchdogStatusSummary}"
                           Visibility="{Binding IsWatchdogActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource PulseDangerBrush}"
                           Text="{Binding LastErrorMessage}"
                           Visibility="{Binding LastErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ui:Card>

        <!-- Desktop & CLI AI Apps Local Tunnel Capture Card -->
        <ui:Card Padding="20"
                 Margin="{DynamicResource PulseSectionMargin}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <ui:Button DockPanel.Dock="Right"
                         Padding="12,6"
                         Appearance="Secondary"
                         Content="{conv:Localization Simple_Apps_Refresh}"
                         Command="{Binding RefreshAiAppsCommand}" />
              <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{conv:Localization Simple_Apps_Title}" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{conv:Localization Simple_Apps_Subtitle}" />
              </StackPanel>
            </DockPanel>

            <TextBlock Margin="0,0,0,8"
                       FontSize="12"
                       Foreground="{StaticResource PulseSuccessBrush}"
                       Text="{Binding AiAppActionStatus}"
                       Visibility="{Binding AiAppActionStatus, Converter={StaticResource NullToVisibilityConverter}}" />

            <ItemsControl ItemsSource="{Binding DetectedAiApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8"
                          Padding="12,10"
                          CornerRadius="8"
                          Background="{DynamicResource PulseInnerPanelBrush}"
                          BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
                          BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     Text="{Binding DisplayName}" />
                          <TextBlock Margin="8,0,0,0"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Text="{Binding Category}" />
                          <TextBlock Margin="8,0,0,0"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource PulseSuccessBrush}"
                                     Text="{Binding StatusBadgeText}" />
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding PrimaryDomain}" />
                      </StackPanel>

                      <ui:Button Grid.Column="1"
                                 Margin="0,0,8,0"
                                 Padding="10,5"
                                 Appearance="Secondary"
                                 FontSize="12"
                                 Content="{conv:Localization Simple_Apps_CopyCmd}"
                                 Command="{Binding DataContext.CopyAiAppSnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 CommandParameter="{Binding}" />

                      <ui:Button Grid.Column="2"
                                 Padding="12,5"
                                 Appearance="Primary"
                                 FontSize="12"
                                 Content="{conv:Localization Simple_Apps_Launch}"
                                 Command="{Binding DataContext.LaunchAiAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>
      </StackPanel>

      <!-- EXPERT MODE: Full Guided 1-2-3 Hero, Strategy Profiles & Live Telemetry -->
      <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <!-- Guided 1-2-3 Hero Card -->
      <ui:Card Padding="{DynamicResource PulseHeroPadding}"
               Margin="{DynamicResource PulseSectionMargin}"
               AutomationProperties.LiveSetting="Polite"
               AutomationProperties.Name="{Binding HeroStatusTitle}"
               AutomationProperties.HelpText="{Binding HeroStatusSubtitle}">
        <StackPanel>
          <!-- Hero Connection Status Header -->
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status Indicator Pill -->
            <Border Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="24"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"
                    Background="{Binding HeroState, Converter={StaticResource VerdictToBrushConverter}}">
              <ui:SymbolIcon Symbol="ShieldCheckmark24"
                             FontSize="24"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Border>

            <!-- Status Title & Subtitle -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
              <ui:TextBlock FontTypography="TitleLarge"
                            Text="{Binding HeroStatusTitle}"
                            TextWrapping="Wrap" />
              <TextBlock Margin="0,3,0,0"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         FontSize="14"
                         Text="{Binding HeroStatusSubtitle}"
                         TextWrapping="Wrap" />
              <ui:TextBlock Margin="0,4,0,0"
                            Foreground="{StaticResource PulseDangerBrush}"
                            Text="{Binding LastErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding LastErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>

            <!-- Manual Connect / Disconnect Toggle (Secondary Power Switch) -->
            <ui:Button Grid.Column="2"
                       MinWidth="136"
                       Height="38"
                       Padding="14,6"
                       Appearance="Secondary"
                       VerticalAlignment="Center"
                       TabIndex="3"
                       Content="{Binding ConnectButtonText}"
                       Command="{Binding ToggleConnectionCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                       AutomationProperties.Name="{conv:Localization Auto_HeroConnectButton}"
                       AutomationProperties.HelpText="{conv:Localization Auto_HeroConnectButton}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Power24" />
              </ui:Button.Icon>
            </ui:Button>
          </Grid>

          <!-- Step 1: What do you want to open? -->
          <Border Padding="18"
                  CornerRadius="8"
                  Background="{DynamicResource PulseInnerPanelBrush}"
                  BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
                  BorderThickness="1">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Border DockPanel.Dock="Right"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="{DynamicResource PulseChipSurfaceBrush}"
                        VerticalAlignment="Center">
                  <TextBlock FontSize="11"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{conv:Localization Overview_QuickConnect_TargetLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text=": " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run FontWeight="SemiBold" Text="{Binding EffectiveTargetDomain, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  </TextBlock>
                </Border>
                <StackPanel>
                  <TextBlock FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Text="{conv:Localization Overview_QuickConnect_Title}" />
                  <TextBlock Margin="0,2,0,0"
                             FontSize="12"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Text="{conv:Localization Overview_QuickConnect_Subtitle}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>

              <!-- Quick Service Chips -->
              <ItemsControl ItemsSource="{Binding QuickServices}" Margin="0,4,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton GroupName="OverviewQuickServices"
                                 Style="{StaticResource PulseFilterChipStyle}"
                                 Content="{Binding Title}"
                                 Tag="{Binding}"
                                 Click="OnQuickServiceChipClick"
                                 AutomationProperties.Name="{Binding Title}"
                                 AutomationProperties.HelpText="{Binding DefaultDomain}">
                      <RadioButton.IsChecked>
                        <MultiBinding Converter="{StaticResource EqualityToBoolConverter}" Mode="OneWay">
                          <Binding />
                          <Binding Path="DataContext.SelectedQuickService" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                      </RadioButton.IsChecked>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Custom Target Domain Input (when "Свой / Custom" is selected) -->
              <ui:TextBox Margin="0,4,0,10"
                          MaxWidth="360"
                          HorizontalAlignment="Left"
                          PlaceholderText="{conv:Localization Overview_QuickConnect_TargetLabel}"
                          Text="{Binding CustomQuickDomain, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding IsCustomQuickServiceSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.Name="{conv:Localization Overview_QuickConnect_TargetLabel}"
                          AutomationProperties.HelpText="{conv:Localization Overview_QuickConnect_Subtitle}" />

              <!-- Step 2: ONE Unmistakable Primary Action Bar -->
              <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                <ui:Button Margin="0,0,10,6"
                           Height="44"
                           Padding="24,8"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Appearance="Primary"
                           TabIndex="1"
                           Content="{conv:Localization Overview_QuickConnect_Button}"
                           Command="{Binding AutoConnectBestCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                           AutomationProperties.Name="{conv:Localization Overview_QuickConnect_Button}"
                           AutomationProperties.HelpText="{conv:Localization Overview_QuickConnect_Subtitle}">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Flash24" />
                  </ui:Button.Icon>
                </ui:Button>

                <ui:Button Margin="0,0,10,6"
                           Height="40"
                           Padding="14,6"
                           Appearance="Secondary"
                           TabIndex="2"
                           Content="{conv:Localization Overview_QuickConnect_VerifyButton}"
                           Command="{Binding VerifyAccessNowCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                           AutomationProperties.Name="{conv:Localization Overview_QuickConnect_VerifyButton}"
                           AutomationProperties.HelpText="{Binding EffectiveTargetDomain}">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                  </ui:Button.Icon>
                </ui:Button>
              </WrapPanel>

              <!-- Live Progress Bar & Step Text -->
              <StackPanel Margin="0,10,0,0"
                          Visibility="{Binding IsAutoFinding, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.LiveSetting="Polite">
                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding AutoSetupProgress}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding AutoSetupStepMessage}" />
              </StackPanel>

              <!-- Step 3: Live 3-Step Verification Checklist & Result Banner -->
              <Border Margin="0,12,0,0"
                      Padding="14,12"
                      CornerRadius="8"
                      BorderThickness="1.5"
                      Visibility="{Binding HasVerificationResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.LiveSetting="Polite">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PulseWarningSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PulseWarningBorderBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsTargetVerifiedWorking}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PulseSuccessSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PulseSuccessBorderBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource PulseWarningBadgeBgBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTargetVerifiedWorking}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource PulseSuccessBadgeBgBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <ui:SymbolIcon FontSize="16" Foreground="White">
                        <ui:SymbolIcon.Style>
                          <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="Warning24" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsTargetVerifiedWorking}" Value="True">
                                <Setter Property="Symbol" Value="Checkmark24" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ui:SymbolIcon.Style>
                      </ui:SymbolIcon>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="{Binding VerificationHeadline}"
                                 TextWrapping="Wrap" />
                      <TextBlock Margin="0,2,0,0"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Text="{Binding VerificationDetails}"
                                 TextWrapping="Wrap"
                                 Visibility="{Binding VerificationDetails, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:Button Margin="0,0,8,0"
                                 Padding="12,6"
                                 Appearance="Primary"
                                 Content="{conv:Localization Banner_BrowserDoh_Fix}"
                                 Command="{Binding FixBrowserDohFromOverviewCommand}"
                                 Visibility="{Binding NeedsBrowserDohAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="{conv:Localization Banner_BrowserDoh_Fix}"
                                 AutomationProperties.HelpText="{Binding DetectedBrowserDohText}" />
                      <ui:Button Margin="0,0,8,0"
                                 Padding="12,6"
                                 Appearance="Primary"
                                 Content="{conv:Localization Overview_Check_Port53Fix}"
                                 Command="{Binding SwitchToSafeProxyModeCommand}"
                                 Visibility="{Binding NeedsPort53FallbackAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="{conv:Localization Overview_Check_Port53Fix}"
                                 AutomationProperties.HelpText="{Binding Port53ConflictSummaryText}" />
                      <ui:Button Padding="12,6"
                                 Appearance="Secondary"
                                 Content="{conv:Localization Overview_QuickConnect_OpenBrowser}"
                                 Command="{Binding OpenTargetInBrowserCommand}"
                                 AutomationProperties.Name="{conv:Localization Overview_QuickConnect_OpenBrowser}"
                                 AutomationProperties.HelpText="{Binding EffectiveTargetDomain}">
                        <ui:Button.Icon>
                          <ui:SymbolIcon Symbol="Open24" />
                        </ui:Button.Icon>
                      </ui:Button>
                    </WrapPanel>
                  </Grid>

                  <!-- 3-Step Live Diagnostic Checklist -->
                  <UniformGrid Columns="3" Margin="0,12,0,0">
                    <!-- Step 1: DNS Hook -->
                    <Border Margin="0,0,8,0"
                            Padding="10,7"
                            CornerRadius="6"
                            Background="{DynamicResource PulseInnerPanelBrush}"
                            BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource PulseWarningBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsChecklistDnsHooked}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource PulseSuccessBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{conv:Localization Overview_Check_Step1}" />
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ChecklistDnsHookSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ChecklistDnsHookSummary}" />
                      </StackPanel>
                    </Border>

                    <!-- Step 2: Unblock IP -->
                    <Border Margin="0,0,8,0"
                            Padding="10,7"
                            CornerRadius="6"
                            Background="{DynamicResource PulseInnerPanelBrush}"
                            BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource PulseWarningBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsChecklistBypassIpResolved}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource PulseSuccessBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{conv:Localization Overview_Check_Step2}" />
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ChecklistBypassIpSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ChecklistBypassIpSummary}" />
                      </StackPanel>
                    </Border>

                    <!-- Step 3: Site Access -->
                    <Border Padding="10,7"
                            CornerRadius="6"
                            Background="{DynamicResource PulseInnerPanelBrush}"
                            BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource PulseWarningBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsChecklistHttpReachable}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource PulseSuccessBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{conv:Localization Overview_Check_Step3}" />
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ChecklistHttpReachableSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ChecklistHttpReachableSummary}" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ui:Card>

      <!-- Strategy Profile Selector -->
      <ui:TextBlock FontTypography="Subtitle"
                    Margin="0,4,0,12"
                    Text="{conv:Localization Overview_Profile_Label}" />

      <ItemsControl ItemsSource="{Binding StrategyProfiles}"
                    Margin="0,0,0,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="OverviewStrategyProfiles"
                         Style="{StaticResource PulseSelectableCardRadioStyle}"
                         Command="{Binding DataContext.SelectStrategyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         CommandParameter="{Binding Profile}"
                         AutomationProperties.Name="{Binding Title}"
                         AutomationProperties.HelpText="{Binding Description}">
              <RadioButton.IsChecked>
                <MultiBinding Converter="{StaticResource EqualityToBoolConverter}" Mode="OneWay">
                  <Binding Path="Profile" />
                  <Binding Path="DataContext.SelectedStrategyProfile" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </MultiBinding>
              </RadioButton.IsChecked>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong"
                              Text="{Binding Title}"
                              TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Text="{Binding Description}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Live Telemetry Strip -->
      <WrapPanel Orientation="Horizontal"
                 Margin="0,0,0,8">
        <!-- Trusted Upstream & Geo-Unlock Card -->
        <ui:Card MinWidth="300"
                 Padding="16"
                 Margin="0,0,12,12">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         FontSize="12"
                         Text="{conv:Localization Overview_Metric_TrustedUpstream}"
                         VerticalAlignment="Center" />
              <Border Margin="8,0,0,0"
                      Padding="7,2"
                      CornerRadius="6"
                      VerticalAlignment="Center"
                      Background="{StaticResource PulseSuccessBrush}">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="{Binding TrustedUpstreamBadge}" />
              </Border>
            </StackPanel>
            <ui:TextBlock Margin="0,4,0,0"
                          FontTypography="BodyStrong"
                          Text="{Binding TrustedUpstreamName}"
                          TextTrimming="CharacterEllipsis" />

            <TextBlock Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="{conv:Localization Overview_Metric_GeoUpstream}" />
            <ui:TextBlock Margin="0,2,0,12"
                          FontTypography="Body"
                          Text="{Binding ActiveGeoUnlockName}"
                          TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal">
              <ui:Button Margin="0,0,8,0"
                         Padding="12,6"
                         TabIndex="4"
                         Content="{conv:Localization Overview_Action_Rotate}"
                         Command="{Binding RotateUpstreamCommand}"
                         AutomationProperties.Name="{conv:Localization Overview_Action_Rotate}"
                         AutomationProperties.HelpText="{conv:Localization Overview_Metric_TrustedUpstream}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
              </ui:Button>
              <ui:Button Padding="12,6"
                         TabIndex="5"
                         Content="{conv:Localization Overview_Action_Refresh}"
                         Command="{Binding RefreshTelemetryCommand}"
                         AutomationProperties.Name="{conv:Localization Overview_Action_Refresh}"
                         AutomationProperties.HelpText="{conv:Localization Overview_Metric_LatencyP50}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
              </ui:Button>
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <!-- Latency p50 & Sparkline Card -->
        <ui:Card MinWidth="260"
                 Padding="16"
                 Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="{conv:Localization Overview_Metric_LatencyP50}" />
            <ui:TextBlock Margin="0,4,0,8"
                          FontTypography="Title"
                          Text="{Binding LatencyP50Ms, Converter={StaticResource LatencyFormatConverter}}" />
            <Border Padding="4"
                    CornerRadius="4"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
              <Polyline Width="220"
                        Height="44"
                        Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        StrokeThickness="2"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round">
                <Polyline.Points>
                  <MultiBinding Converter="{StaticResource SparklinePointsConverter}">
                    <Binding Path="P50SparklineSamples" />
                    <Binding Path="P50SparklineSamples.Count" />
                    <Binding Path="LatencyP50Ms" />
                  </MultiBinding>
                </Polyline.Points>
              </Polyline>
            </Border>
          </StackPanel>
        </ui:Card>

        <!-- Cache Hit % & Queries / min Card -->
        <ui:Card MinWidth="210"
                 Padding="16"
                 Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="{conv:Localization Overview_Metric_CacheHit}" />
            <ui:TextBlock Margin="0,4,0,12"
                          FontTypography="Title"
                          Text="{Binding CacheHitRatePercent, StringFormat={}{0:F1}%}" />

            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="{conv:Localization Overview_Metric_QueriesPerMin}" />
            <ui:TextBlock Margin="0,4,0,0"
                          FontTypography="Title"
                          Text="{Binding QueriesPerMinute, StringFormat={}{0:F1}}" />
          </StackPanel>
        </ui:Card>

        <!-- Interception Mode & Runtime Mode Card -->
        <ui:Card MinWidth="250"
                 Padding="16"
                 Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="{conv:Localization Overview_Metric_InterceptionMode}" />
            <ui:TextBlock Margin="0,4,0,12"
                          FontTypography="BodyStrong"
                          TextWrapping="Wrap">
              <ui:TextBlock.Text>
                <MultiBinding Converter="{StaticResource EnumLocalizationConverter}">
                  <Binding Path="ActiveInterceptionMode" />
                  <Binding Path="[App_Title]" Source="{x:Static conv:LocalizationSource.Instance}" />
                </MultiBinding>
              </ui:TextBlock.Text>
            </ui:TextBlock>

            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Text="{conv:Localization Overview_Metric_RuntimeMode}" />
            <ui:TextBlock Margin="0,4,0,0"
                          FontTypography="BodyStrong"
                          Text="{Binding RuntimeModeLabel}"
                          TextWrapping="Wrap" />
          </StackPanel>
        </ui:Card>
      </WrapPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
