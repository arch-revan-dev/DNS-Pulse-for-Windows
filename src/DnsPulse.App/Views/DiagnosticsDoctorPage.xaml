<UserControl x:Class="DnsPulse.App.Views.DiagnosticsDoctorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:DnsPulse.App.Converters">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="20,16,20,24">
    <StackPanel MaxWidth="1280">
      <!-- 6-Layer Diagnostics Doctor Controls -->
      <ui:Card Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <ui:TextBlock FontTypography="Subtitle"
                        Margin="0,0,0,12"
                        Text="{conv:Localization Diag_Title}" />

          <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox Width="180"
                      Margin="0,0,8,8"
                      ItemsSource="{Binding PresetGroups}"
                      SelectedItem="{Binding SelectedPresetGroup, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                      AutomationProperties.HelpText="{conv:Localization Diag_Title}" />
            <ComboBox Width="220"
                      Margin="0,0,8,8"
                      ItemsSource="{Binding DomainPresets}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                      AutomationProperties.HelpText="{conv:Localization Diag_Title}" />
            <ui:TextBox Width="250"
                        Margin="0,0,8,8"
                        PlaceholderText="{conv:Localization Diag_TargetDomain}"
                        Text="{Binding CustomDomain, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                        AutomationProperties.HelpText="{conv:Localization Auto_RunDiagnosticsButton}" />
            <ui:Button Margin="0,0,8,8"
                       Appearance="Primary"
                       Content="{conv:Localization Diag_Run}"
                       Command="{Binding RunDiagnosticsCommand}"
                       IsEnabled="{Binding IsDiagnosing, Converter={StaticResource InverseBoolConverter}}"
                       AutomationProperties.Name="{conv:Localization Auto_RunDiagnosticsButton}"
                       AutomationProperties.HelpText="{conv:Localization Auto_RunDiagnosticsButton}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Stethoscope24" />
              </ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,0,8"
                       Appearance="Caution"
                       Content="{conv:Localization Diag_Cancel}"
                       Command="{Binding CancelDiagnosticsCommand}"
                       Visibility="{Binding IsDiagnosing, Converter={StaticResource BooleanToVisibilityConverter}}"
                       AutomationProperties.Name="{conv:Localization Diag_Cancel}"
                       AutomationProperties.HelpText="{conv:Localization Diag_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Stop24" />
              </ui:Button.Icon>
            </ui:Button>
          </WrapPanel>

          <!-- Quick Preset Chips -->
          <ItemsControl ItemsSource="{Binding DomainPresets}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="DiagnosticPresetChips"
                             Style="{StaticResource PulseFilterChipStyle}"
                             Content="{Binding Label}"
                             Click="OnPresetChipClick"
                             Tag="{Binding}"
                             AutomationProperties.Name="{Binding Label}"
                             AutomationProperties.HelpText="{Binding Domain}">
                  <RadioButton.IsChecked>
                    <MultiBinding Converter="{StaticResource EqualityToBoolConverter}" Mode="OneWay">
                      <Binding />
                      <Binding Path="DataContext.SelectedPreset" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                  </RadioButton.IsChecked>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:Card>

      <!-- 6 Animated Layer Step Cards -->
      <ItemsControl ItemsSource="{Binding Layers}" Margin="0,0,0,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Padding="14"
                     Margin="0,0,10,10"
                     Opacity="0">
              <ui:Card.RenderTransform>
                <TranslateTransform Y="8" />
              </ui:Card.RenderTransform>
              <ui:Card.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0" To="1" Duration="0:0:0.25" />
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                       From="8" To="0" Duration="0:0:0.25" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </ui:Card.Triggers>
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0"
                          Width="24"
                          Height="24"
                          CornerRadius="12"
                          Margin="0,0,8,0"
                          Background="{Binding Status, Converter={StaticResource VerdictToBrushConverter}}">
                    <TextBlock Text="{Binding LayerNumber}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <ui:TextBlock Grid.Column="1"
                                FontTypography="BodyStrong"
                                VerticalAlignment="Center"
                                Text="{Binding LayerName}"
                                TextTrimming="CharacterEllipsis" />
                  <ui:TextBlock Grid.Column="2"
                                Appearance="Secondary"
                                FontTypography="Caption"
                                VerticalAlignment="Center"
                                Text="{Binding Duration, Converter={StaticResource LatencyFormatConverter}}" />
                </Grid>
                <ui:TextBlock Appearance="Secondary"
                              FontTypography="Caption"
                              Text="{Binding Summary}"
                              TextWrapping="Wrap" />
              </StackPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Verdict & 1-Click Remediation Card -->
      <ui:Card Padding="16"
               Margin="0,0,0,12"
               AutomationProperties.LiveSetting="Polite"
               AutomationProperties.Name="{Binding VerdictTitle}"
               AutomationProperties.HelpText="{Binding VerdictReason}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse Grid.Column="0"
                   Width="18"
                   Height="18"
                   Margin="0,0,14,0"
                   VerticalAlignment="Center"
                   Fill="{Binding CurrentVerdict, Converter={StaticResource VerdictToBrushConverter}}" />

          <StackPanel Grid.Column="1" Margin="0,0,16,0">
            <ui:TextBlock FontTypography="Subtitle"
                          Text="{Binding VerdictTitle}"
                          TextWrapping="Wrap" />
            <ui:TextBlock Margin="0,4,0,0"
                          Appearance="Secondary"
                          Text="{Binding VerdictReason}"
                          TextWrapping="Wrap"
                          Visibility="{Binding VerdictReason, Converter={StaticResource NullToVisibilityConverter}}" />
            <ui:TextBlock Margin="0,6,0,0"
                          FontTypography="BodyStrong"
                          Text="{Binding RemediationTitle}"
                          TextWrapping="Wrap" />
            <ui:TextBlock Margin="0,4,0,0"
                          Foreground="{StaticResource PulseSuccessBrush}"
                          FontTypography="Caption"
                          Text="{Binding RemediationFeedback}"
                          Visibility="{Binding RemediationFeedback, Converter={StaticResource NullToVisibilityConverter}}" />
          </StackPanel>

          <ui:Button Grid.Column="2"
                     VerticalAlignment="Center"
                     Appearance="Primary"
                     Content="{conv:Localization Diag_ApplyFix}"
                     Command="{Binding ApplyRecommendedFixCommand}"
                     IsEnabled="{Binding CanApplyRemediation}"
                     AutomationProperties.Name="{conv:Localization Auto_ApplyRemediationButton}"
                     AutomationProperties.HelpText="{Binding RemediationTitle}">
            <ui:Button.Icon>
              <ui:SymbolIcon Symbol="Wrench24" />
            </ui:Button.Icon>
          </ui:Button>
        </Grid>
      </ui:Card>

      <!-- Advanced Network Lab (Opt-In Only) -->
      <ui:CardExpander Header="{conv:Localization Diag_Lab_Title}"
                       Margin="0,0,0,12">
        <ui:CardExpander.Icon>
          <ui:SymbolIcon Symbol="Globe24" />
        </ui:CardExpander.Icon>
        <StackPanel>
          <ui:InfoBar IsOpen="True"
                      IsClosable="False"
                      Severity="Warning"
                      Margin="0,0,0,12"
                      Title="{conv:Localization Diag_Lab_Title}"
                      Message="{conv:Localization Diag_Lab_Disclaimer}" />

          <CheckBox Margin="0,0,0,12"
                    IsChecked="{Binding HasAcceptedLabDisclaimer, Mode=TwoWay}"
                    Content="{conv:Localization Diag_Lab_Accept}"
                    AutomationProperties.Name="{conv:Localization Diag_Lab_Accept}"
                    AutomationProperties.HelpText="{conv:Localization Diag_Lab_Disclaimer}" />

          <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBox Width="220"
                        Margin="0,0,8,8"
                        PlaceholderText="CIDR (e.g. 203.0.113.0/24)"
                        Text="{Binding LabCustomCidr, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_Lab_Title}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lab_Disclaimer}" />
            <ui:TextBox Width="220"
                        Margin="0,0,8,8"
                        PlaceholderText="{conv:Localization Diag_TargetDomain}"
                        Text="{Binding LabTargetDomain, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lab_Title}" />
            <ui:Button Margin="0,0,8,8"
                       Appearance="Primary"
                       Content="{conv:Localization Diag_Lab_Start}"
                       Command="{Binding StartLabScanCommand}"
                       IsEnabled="{Binding HasAcceptedLabDisclaimer}"
                       AutomationProperties.Name="{conv:Localization Diag_Lab_Start}"
                       AutomationProperties.HelpText="{conv:Localization Diag_Lab_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Play24" />
              </ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,0,8"
                       Appearance="Caution"
                       Content="{conv:Localization Diag_Lab_Stop}"
                       Command="{Binding StopLabScanCommand}"
                       Visibility="{Binding IsScanningLab, Converter={StaticResource BooleanToVisibilityConverter}}"
                       AutomationProperties.Name="{conv:Localization Diag_Lab_Stop}"
                       AutomationProperties.HelpText="{conv:Localization Diag_Lab_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Stop24" />
              </ui:Button.Icon>
            </ui:Button>
          </WrapPanel>

          <ui:TextBlock Margin="0,0,0,8"
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding LabProgressText}"
                        Visibility="{Binding LabProgressText, Converter={StaticResource NullToVisibilityConverter}}" />

          <ListView MaxHeight="180"
                    ItemsSource="{Binding LabDiscoveredNodes}"
                    Visibility="{Binding LabDiscoveredNodes.Count, Converter={StaticResource NullToVisibilityConverter}}"
                    AutomationProperties.Name="{conv:Localization Diag_Lab_Title}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                  <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                  <ui:TextBlock Margin="12,0,0,0" Appearance="Secondary" Text="{Binding EndpointLabel}" />
                  <ui:TextBlock Margin="12,0,0,0" Text="{Binding LatencyP50Ms, Converter={StaticResource LatencyFormatConverter}}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </ui:CardExpander>

      <!-- LAN Gateway Mode Sharing Panel -->
      <ui:Card Padding="16">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="QrCode24" Margin="0,0,10,0" />
              <ui:TextBlock FontTypography="Subtitle"
                            VerticalAlignment="Center"
                            Text="{conv:Localization Diag_Lan_Title}" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1"
                             IsChecked="{Binding IsLanGatewayEnabled, Mode=TwoWay}"
                             OnContent="{conv:Localization Diag_Lan_Enable}"
                             OffContent="{conv:Localization Diag_Lan_Enable}"
                             AutomationProperties.Name="{conv:Localization Diag_Lan_Enable}"
                             AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
          </Grid>

          <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox Width="170"
                        Margin="0,0,8,8"
                        PlaceholderText="LAN IP"
                        Text="{Binding LanIpAddress, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_Lan_Title}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Enable}" />
            <ui:TextBox Width="90"
                        Margin="0,0,8,8"
                        PlaceholderText="DNS Port"
                        Text="{Binding LanDnsPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="DNS Port"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            <ui:TextBox Width="90"
                        Margin="0,0,8,8"
                        PlaceholderText="PAC Port"
                        Text="{Binding LanPacPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="PAC Port"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            <ui:TextBox Width="90"
                        Margin="0,0,8,8"
                        PlaceholderText="Proxy Port"
                        Text="{Binding LanProxyPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Proxy Port"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            <ui:Button Margin="0,0,0,8"
                       Content="{conv:Localization Diag_Lan_Refresh}"
                       Command="{Binding RefreshLanGatewayCommand}"
                       AutomationProperties.Name="{conv:Localization Diag_Lan_Refresh}"
                       AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowClockwise24" />
              </ui:Button.Icon>
            </ui:Button>
          </WrapPanel>

          <Grid Visibility="{Binding LanGateway, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    Margin="0,0,20,0"
                    CornerRadius="8"
                    Background="White"
                    VerticalAlignment="Top">
              <Image Width="176"
                     Height="176"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     Source="{Binding LanGateway.PacQrMatrix, Converter={StaticResource QrMatrixToImageSourceConverter}}"
                     AutomationProperties.Name="{Binding LanGateway.PacUrl}"
                     AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="DNS Endpoint" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <ui:TextBlock FontFamily="Consolas"
                              FontTypography="BodyStrong"
                              VerticalAlignment="Center"
                              Text="{Binding LanGateway.DnsEndpoint}" />
                <ui:Button Margin="8,0,0,0"
                           Padding="8,4"
                           Tag="{Binding LanGateway.DnsEndpoint}"
                           Click="OnCopyEndpointClick"
                           AutomationProperties.Name="Copy DNS Endpoint"
                           AutomationProperties.HelpText="{Binding LanGateway.DnsEndpoint}">
                  <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button>
              </StackPanel>

              <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="PAC URL" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <ui:TextBlock FontFamily="Consolas"
                              FontTypography="BodyStrong"
                              VerticalAlignment="Center"
                              Text="{Binding LanGateway.PacUrl}" />
                <ui:Button Margin="8,0,0,0"
                           Padding="8,4"
                           Tag="{Binding LanGateway.PacUrl}"
                           Click="OnCopyEndpointClick"
                           AutomationProperties.Name="Copy PAC URL"
                           AutomationProperties.HelpText="{Binding LanGateway.PacUrl}">
                  <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button>
              </StackPanel>

              <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="Proxy Endpoint" />
              <ui:TextBlock Margin="0,2,0,0"
                            FontFamily="Consolas"
                            FontTypography="BodyStrong"
                            Text="{Binding LanGateway.ProxyEndpoint}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
