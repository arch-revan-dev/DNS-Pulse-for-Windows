<UserControl x:Class="DnsPulse.App.Views.DiagnosticsDoctorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:DnsPulse.App.Behaviors"
             xmlns:conv="clr-namespace:DnsPulse.App.Converters">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                behaviors:SmoothScrollBehavior.IsEnabled="True"
                Padding="{DynamicResource PulsePagePadding}">
    <StackPanel MaxWidth="1280">
      <!-- Page Header + 3-Tab Segmented Switcher -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Text="{conv:Localization Diag_Title}" />
          <TextBlock Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Text="{conv:Localization Diag_Page_Subtitle}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="1"
                Padding="4"
                CornerRadius="11"
                VerticalAlignment="Center"
                Background="{DynamicResource PulseSegmentTrackBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="DiagSubTabs"
                         Style="{StaticResource PulseIosSegmentRadioStyle}"
                         Command="{Binding SelectSubTabCommand}"
                         IsChecked="{Binding IsDoctorTabSelected, Mode=OneWay}"
                         Content="{conv:Localization Diag_SubTab_Doctor}"
                         AutomationProperties.Name="{conv:Localization Diag_SubTab_Doctor}">
              <RadioButton.CommandParameter>
                <sys:Int32>0</sys:Int32>
              </RadioButton.CommandParameter>
            </RadioButton>

            <RadioButton GroupName="DiagSubTabs"
                         Style="{StaticResource PulseIosSegmentRadioStyle}"
                         Command="{Binding SelectSubTabCommand}"
                         IsChecked="{Binding IsLanTabSelected, Mode=OneWay}"
                         Content="{conv:Localization Diag_SubTab_Lan}"
                         AutomationProperties.Name="{conv:Localization Diag_SubTab_Lan}">
              <RadioButton.CommandParameter>
                <sys:Int32>1</sys:Int32>
              </RadioButton.CommandParameter>
            </RadioButton>

            <RadioButton GroupName="DiagSubTabs"
                         Style="{StaticResource PulseIosSegmentRadioStyle}"
                         Command="{Binding SelectSubTabCommand}"
                         IsChecked="{Binding IsLabTabSelected, Mode=OneWay}"
                         Content="{conv:Localization Diag_SubTab_Lab}"
                         AutomationProperties.Name="{conv:Localization Diag_SubTab_Lab}">
              <RadioButton.CommandParameter>
                <sys:Int32>2</sys:Int32>
              </RadioButton.CommandParameter>
            </RadioButton>
          </StackPanel>
        </Border>
      </Grid>

      <!-- SUB-TAB 0: 6-Layer Diagnostics Doctor -->
      <StackPanel Visibility="{Binding IsDoctorTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Padding="18"
                Margin="0,0,0,14"
                CornerRadius="14"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1">
          <StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ComboBox Width="180"
                        Margin="0,0,8,8"
                        ItemsSource="{Binding PresetGroups}"
                        SelectedItem="{Binding SelectedPresetGroup, Mode=TwoWay}"
                        DisplayMemberPath="Label"
                        AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Title}" />
              <ComboBox Width="220"
                        Margin="0,0,8,8"
                        ItemsSource="{Binding DomainPresets}"
                        SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                        DisplayMemberPath="Label"
                        AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Title}" />
              <ui:TextBox Width="250"
                          Margin="0,0,8,8"
                          PlaceholderText="{conv:Localization Diag_TargetDomain}"
                          Text="{Binding CustomDomain, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                          AutomationProperties.HelpText="{conv:Localization Auto_RunDiagnosticsButton}" />
              <ui:Button Margin="0,0,8,8"
                         Appearance="Primary"
                         Content="{conv:Localization Diag_Run}"
                         Command="{Binding RunDiagnosticsCommand}"
                         IsEnabled="{Binding IsDiagnosing, Converter={StaticResource InverseBoolConverter}}"
                         AutomationProperties.Name="{conv:Localization Auto_RunDiagnosticsButton}"
                         AutomationProperties.HelpText="{conv:Localization Auto_RunDiagnosticsButton}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="Stethoscope24" />
                </ui:Button.Icon>
              </ui:Button>
              <ui:Button Margin="0,0,0,8"
                         Appearance="Caution"
                         Content="{conv:Localization Diag_Cancel}"
                         Command="{Binding CancelDiagnosticsCommand}"
                         Visibility="{Binding IsDiagnosing, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.Name="{conv:Localization Diag_Cancel}"
                         AutomationProperties.HelpText="{conv:Localization Diag_Title}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="Stop24" />
                </ui:Button.Icon>
              </ui:Button>
            </WrapPanel>

            <!-- Quick Preset Chips -->
            <ItemsControl ItemsSource="{Binding DomainPresets}" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="DiagnosticPresetChips"
                               Style="{StaticResource PulseFilterChipStyle}"
                               Content="{Binding Label}"
                               Click="OnPresetChipClick"
                               Tag="{Binding}"
                               AutomationProperties.Name="{Binding Label}"
                               AutomationProperties.HelpText="{Binding Domain}">
                    <RadioButton.IsChecked>
                      <MultiBinding Converter="{StaticResource EqualityToBoolConverter}" Mode="OneWay">
                        <Binding />
                        <Binding Path="DataContext.SelectedPreset" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                      </MultiBinding>
                    </RadioButton.IsChecked>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 6 Animated Layer Step Cards -->
        <ItemsControl ItemsSource="{Binding Layers}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Padding="14"
                       Margin="0,0,10,10"
                       Opacity="0">
                <ui:Card.RenderTransform>
                  <TranslateTransform Y="8" />
                </ui:Card.RenderTransform>
                <ui:Card.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.25" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         From="8" To="0" Duration="0:0:0.25" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </ui:Card.Triggers>
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="24"
                            Height="24"
                            CornerRadius="12"
                            Margin="0,0,8,0"
                            Background="{Binding Status, Converter={StaticResource VerdictToBrushConverter}}">
                      <TextBlock Text="{Binding LayerNumber}"
                                 Foreground="White"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <ui:TextBlock Grid.Column="1"
                                  FontTypography="BodyStrong"
                                  VerticalAlignment="Center"
                                  Text="{Binding LayerName}"
                                  TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding Duration, Converter={StaticResource LatencyFormatConverter}}" />
                  </Grid>
                  <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             FontSize="12"
                             Text="{Binding Summary}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Verdict & 1-Click Remediation Card -->
        <Border Padding="18"
                CornerRadius="14"
                Background="{DynamicResource PulseGlassCardBrush}"
                BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
                BorderThickness="1"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding VerdictTitle}"
                AutomationProperties.HelpText="{Binding VerdictReason}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0"
                     Width="18"
                     Height="18"
                     Margin="0,0,14,0"
                     VerticalAlignment="Center"
                     Fill="{Binding CurrentVerdict, Converter={StaticResource VerdictToBrushConverter}}" />

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
              <ui:TextBlock FontTypography="Subtitle"
                            Text="{Binding VerdictTitle}"
                            TextWrapping="Wrap" />
              <TextBlock Margin="0,4,0,0"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         FontSize="13"
                         Text="{Binding VerdictReason}"
                         TextWrapping="Wrap"
                         Visibility="{Binding VerdictReason, Converter={StaticResource NullToVisibilityConverter}}" />
              <ui:TextBlock Margin="0,6,0,0"
                            FontTypography="BodyStrong"
                            Text="{Binding RemediationTitle}"
                            TextWrapping="Wrap" />
              <ui:TextBlock Margin="0,4,0,0"
                            Foreground="{StaticResource PulseSuccessBrush}"
                            FontTypography="Caption"
                            Text="{Binding RemediationFeedback}"
                            Visibility="{Binding RemediationFeedback, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>

            <ui:Button Grid.Column="2"
                       VerticalAlignment="Center"
                       Appearance="Primary"
                       Content="{conv:Localization Diag_ApplyFix}"
                       Command="{Binding ApplyRecommendedFixCommand}"
                       IsEnabled="{Binding CanApplyRemediation}"
                       AutomationProperties.Name="{conv:Localization Auto_ApplyRemediationButton}"
                       AutomationProperties.HelpText="{Binding RemediationTitle}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Wrench24" />
              </ui:Button.Icon>
            </ui:Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- SUB-TAB 1: LAN Gateway & QR Code Sharing -->
      <Border Padding="18"
              CornerRadius="14"
              Background="{DynamicResource PulseGlassCardBrush}"
              BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
              BorderThickness="1"
              Visibility="{Binding IsLanTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="QrCode24" Margin="0,0,10,0" />
              <ui:TextBlock FontTypography="Subtitle"
                            VerticalAlignment="Center"
                            Text="{conv:Localization Diag_Lan_Title}" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1"
                             IsChecked="{Binding IsLanGatewayEnabled, Mode=TwoWay}"
                             OnContent="{conv:Localization Diag_Lan_Enable}"
                             OffContent="{conv:Localization Diag_Lan_Enable}"
                             AutomationProperties.Name="{conv:Localization Diag_Lan_Enable}"
                             AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
          </Grid>

          <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
            <ui:TextBox Width="170"
                        Margin="0,0,8,8"
                        PlaceholderText="{conv:Localization Diag_Lan_IpPlaceholder}"
                        Text="{Binding LanIpAddress, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_Lan_IpPlaceholder}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Enable}" />
            <ui:TextBox Width="110"
                        Margin="0,0,8,8"
                        PlaceholderText="{conv:Localization Diag_Lan_DnsPort}"
                        Text="{Binding LanDnsPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_Lan_DnsPort}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            <ui:TextBox Width="110"
                        Margin="0,0,8,8"
                        PlaceholderText="{conv:Localization Diag_Lan_PacPort}"
                        Text="{Binding LanPacPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_Lan_PacPort}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            <ui:TextBox Width="110"
                        Margin="0,0,8,8"
                        PlaceholderText="{conv:Localization Diag_Lan_ProxyPort}"
                        Text="{Binding LanProxyPort, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_Lan_ProxyPort}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            <ui:Button Margin="0,0,0,8"
                       Content="{conv:Localization Diag_Lan_Refresh}"
                       Command="{Binding RefreshLanGatewayCommand}"
                       AutomationProperties.Name="{conv:Localization Diag_Lan_Refresh}"
                       AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowClockwise24" />
              </ui:Button.Icon>
            </ui:Button>
          </WrapPanel>

          <Grid Visibility="{Binding LanGateway, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    Margin="0,0,20,0"
                    CornerRadius="10"
                    Background="White"
                    VerticalAlignment="Top">
              <Image Width="176"
                     Height="176"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     Source="{Binding LanGateway.PacQrMatrix, Converter={StaticResource QrMatrixToImageSourceConverter}}"
                     AutomationProperties.Name="{Binding LanGateway.PacUrl}"
                     AutomationProperties.HelpText="{conv:Localization Diag_Lan_Title}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="{conv:Localization Diag_Lan_DnsEndpoint}" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <ui:TextBlock FontFamily="Consolas"
                              FontTypography="BodyStrong"
                              VerticalAlignment="Center"
                              Text="{Binding LanGateway.DnsEndpoint}" />
                <ui:Button Margin="8,0,0,0"
                           Padding="8,4"
                           Tag="{Binding LanGateway.DnsEndpoint}"
                           Click="OnCopyEndpointClick"
                           ToolTip="{conv:Localization Diag_Lan_CopyDns}"
                           AutomationProperties.Name="{conv:Localization Diag_Lan_CopyDns}"
                           AutomationProperties.HelpText="{Binding LanGateway.DnsEndpoint}">
                  <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button>
              </StackPanel>

              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="{conv:Localization Diag_Lan_PacUrl}" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <ui:TextBlock FontFamily="Consolas"
                              FontTypography="BodyStrong"
                              VerticalAlignment="Center"
                              Text="{Binding LanGateway.PacUrl}" />
                <ui:Button Margin="8,0,0,0"
                           Padding="8,4"
                           Tag="{Binding LanGateway.PacUrl}"
                           Click="OnCopyEndpointClick"
                           ToolTip="{conv:Localization Diag_Lan_CopyPac}"
                           AutomationProperties.Name="{conv:Localization Diag_Lan_CopyPac}"
                           AutomationProperties.HelpText="{Binding LanGateway.PacUrl}">
                  <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button>
              </StackPanel>

              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="{conv:Localization Diag_Lan_ProxyEndpoint}" />
              <ui:TextBlock Margin="0,2,0,0"
                            FontFamily="Consolas"
                            FontTypography="BodyStrong"
                            Text="{Binding LanGateway.ProxyEndpoint}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- SUB-TAB 2: Advanced Network Lab (Opt-In CIDR Discovery) -->
      <Border Padding="18"
              CornerRadius="14"
              Background="{DynamicResource PulseGlassCardBrush}"
              BorderBrush="{DynamicResource PulseGlassCardBorderBrush}"
              BorderThickness="1"
              Visibility="{Binding IsLabTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Border Margin="0,0,0,14"
                  Padding="12,10"
                  CornerRadius="8"
                  Background="{DynamicResource PulseWarningSubtleBrush}"
                  BorderBrush="{DynamicResource PulseWarningBorderBrush}"
                  BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0"
                      Width="26"
                      Height="26"
                      CornerRadius="13"
                      Margin="0,0,12,0"
                      VerticalAlignment="Top"
                      Background="{DynamicResource PulseWarningBadgeBgBrush}">
                <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="White" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{conv:Localization Diag_Lab_Title}" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{conv:Localization Diag_Lab_Disclaimer}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <CheckBox Margin="0,0,0,12"
                    IsChecked="{Binding HasAcceptedLabDisclaimer, Mode=TwoWay}"
                    Content="{conv:Localization Diag_Lab_Accept}"
                    AutomationProperties.Name="{conv:Localization Diag_Lab_Accept}"
                    AutomationProperties.HelpText="{conv:Localization Diag_Lab_Disclaimer}" />

          <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBox Width="220"
                        Margin="0,0,8,8"
                        PlaceholderText="CIDR (203.0.113.0/24)"
                        Text="{Binding LabCustomCidr, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_Lab_Title}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lab_Disclaimer}" />
            <ui:TextBox Width="220"
                        Margin="0,0,8,8"
                        PlaceholderText="{conv:Localization Diag_TargetDomain}"
                        Text="{Binding LabTargetDomain, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{conv:Localization Diag_TargetDomain}"
                        AutomationProperties.HelpText="{conv:Localization Diag_Lab_Title}" />
            <ui:Button Margin="0,0,8,8"
                       Appearance="Primary"
                       Content="{conv:Localization Diag_Lab_Start}"
                       Command="{Binding StartLabScanCommand}"
                       IsEnabled="{Binding HasAcceptedLabDisclaimer}"
                       AutomationProperties.Name="{conv:Localization Diag_Lab_Start}"
                       AutomationProperties.HelpText="{conv:Localization Diag_Lab_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Play24" />
              </ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,0,8"
                       Appearance="Caution"
                       Content="{conv:Localization Diag_Lab_Stop}"
                       Command="{Binding StopLabScanCommand}"
                       Visibility="{Binding IsScanningLab, Converter={StaticResource BooleanToVisibilityConverter}}"
                       AutomationProperties.Name="{conv:Localization Diag_Lab_Stop}"
                       AutomationProperties.HelpText="{conv:Localization Diag_Lab_Title}">
              <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Stop24" />
              </ui:Button.Icon>
            </ui:Button>
          </WrapPanel>

          <TextBlock Margin="0,0,0,8"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     FontSize="12"
                     Text="{Binding LabProgressText}"
                     Visibility="{Binding LabProgressText, Converter={StaticResource NullToVisibilityConverter}}" />

          <ListView MaxHeight="260"
                    Style="{StaticResource PulseDarkCardListViewStyle}"
                    ItemContainerStyle="{StaticResource PulseDarkListViewItemStyle}"
                    behaviors:SmoothScrollBehavior.IsEnabled="True"
                    ItemsSource="{Binding LabDiscoveredNodes}"
                    Visibility="{Binding LabDiscoveredNodes.Count, Converter={StaticResource NullToVisibilityConverter}}"
                    AutomationProperties.Name="{conv:Localization Diag_Lab_Title}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,7"
                        Margin="0,0,0,4"
                        CornerRadius="6"
                        Background="{DynamicResource PulseInnerPanelBrush}"
                        BorderBrush="{DynamicResource PulseInnerPanelBorderBrush}"
                        BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding EndpointLabel}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding LatencyP50Ms, Converter={StaticResource LatencyFormatConverter}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
