<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DnsPulse</AssemblyName>
    <RootNamespace>DnsPulse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.23" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnsPulse.Core\DnsPulse.Core.csproj" />
    <ProjectReference Include="..\DnsPulse.Engine\DnsPulse.Engine.csproj" />
    <ProjectReference Include="..\DnsPulse.Platform.Windows\DnsPulse.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Content Include="..\..\assets\dns_catalog_1000.tsv" Link="assets\dns_catalog_1000.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\..\assets\dns_catalog_1000.tsv" LogicalName="DnsPulse.App.assets.dns_catalog_1000.tsv" />
  </ItemGroup>
</Project>
