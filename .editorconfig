root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,xaml,xml,manifest,json,md}]
indent_style = space

[*.cs]
indent_size = 4

# Code style & formatting preferences
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Compatibility rules for AnalysisLevel=latest-all + TreatWarningsAsErrors=true
# Keep correctness, security, and disposal analyzers active; tune noisy/app-incompatible rules.
dotnet_diagnostic.CA1014.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA2007.severity = none

[*.{csproj,props,targets,xaml,xml,manifest}]
indent_size = 2

[tests/**/*.cs]
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA2000.severity = suggestion

[src/DnsPulse.App/App.xaml.cs]
dotnet_diagnostic.CA1724.severity = none
