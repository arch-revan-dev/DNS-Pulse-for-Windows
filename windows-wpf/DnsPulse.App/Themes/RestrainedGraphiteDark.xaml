<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces (Restrained Graphite Dark) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0D10" />
    <SolidColorBrush x:Key="WindowCaptionBgBrush" Color="#0F1217" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#13161B" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#1B2028" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#232934" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#2B3340" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#17241D" />

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#262C36" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#3A4352" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1F252F" />

    <!-- Typography -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />

    <!-- High-Contrast Primary CTA -->
    <SolidColorBrush x:Key="PrimaryButtonBgBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="PrimaryButtonFgBrush" Color="#0B0D10" />

    <!-- Accent & Semantic Status -->
    <SolidColorBrush x:Key="AccentBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="AccentFgBrush" Color="#0B0D10" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2216A34A" />

    <SolidColorBrush x:Key="StatusOkBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#64748B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26EF4444" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#334155" />
</ResourceDictionary>
