<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces (Deep Graphite Dark) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#0F131A" />
    <SolidColorBrush x:Key="WindowCaptionBgBrush" Color="#0E1219" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#131822" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#181E2A" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#1A212E" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#222A3A" />
    <SolidColorBrush x:Key="SubtleRowHoverBrush" Color="#171D29" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#2A3447" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#13251D" />
    <SolidColorBrush x:Key="BadgeBgBrush" Color="#1E2636" />

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#252E3F" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#3A4760" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1E2534" />

    <!-- Typography -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />

    <!-- High-Contrast Primary CTA -->
    <SolidColorBrush x:Key="PrimaryButtonBgBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryButtonFgBrush" Color="#0B0E14" />

    <!-- Accent & Semantic Status -->
    <SolidColorBrush x:Key="AccentBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="AccentFgBrush" Color="#062210" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E22C55E" />

    <SolidColorBrush x:Key="StatusOkBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#64748B" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#22F59E0B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#24EF4444" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#2264748B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#334155" />
</ResourceDictionary>
