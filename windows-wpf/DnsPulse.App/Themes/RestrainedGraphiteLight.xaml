<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces (Restrained Graphite Light) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="WindowCaptionBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#EEF2F6" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#EAF7EE" />

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#DCE2EA" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E6EBF1" />

    <!-- Typography -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#334155" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

    <!-- High-Contrast Primary CTA -->
    <SolidColorBrush x:Key="PrimaryButtonBgBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="PrimaryButtonFgBrush" Color="#FFFFFF" />

    <!-- Accent & Semantic Status -->
    <SolidColorBrush x:Key="AccentBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#15803D" />
    <SolidColorBrush x:Key="AccentFgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A16A34A" />

    <SolidColorBrush x:Key="StatusOkBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#D97706" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#64748B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1AEF4444" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CBD5E1" />
</ResourceDictionary>
