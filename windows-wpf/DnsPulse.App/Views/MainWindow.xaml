<Window x:Class="DnsPulse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DnsPulse.App.Models"
        Title="DNS Pulse"
        Height="860"
        Width="1360"
        MinHeight="680"
        MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Row 0: Custom Window Titlebar + 3-Zone App Navigation & Primary Actions -->
        <Border Grid.Row="0"
                Background="{DynamicResource WindowCaptionBgBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Zone 1: Brand Wordmark -->
                <TextBlock Grid.Column="0"
                           Text="DNS Pulse"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <!-- Zone 2: Clean Underline Navigation Tabs -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton Content="Тестер"
                                 GroupName="MainNav"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 IsChecked="{Binding IsTesterTab, Mode=OneWay}"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="0" />
                    <RadioButton Content="Каталог"
                                 GroupName="MainNav"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 IsChecked="{Binding IsCatalogTab, Mode=OneWay}"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="1" />
                    <RadioButton Content="Конфиги"
                                 GroupName="MainNav"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 IsChecked="{Binding IsConfigsTab, Mode=OneWay}"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="2" />
                </StackPanel>

                <!-- Zone 4: Workspace Toolbar Actions -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeToggleBtn"
                            Content="Тема"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,6,0"
                            Click="OnToggleThemeClick"
                            ToolTip="Переключить светлую/тёмную тему" />
                    <Button Content="+ Добавить"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,6,0"
                            Click="OnOpenManualAddClick" />
                    <Button Content="Подбор"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,6,0"
                            Click="OnOpenDiscoveryClick" />
                    <ToggleButton Content="LIVE"
                                  Style="{StaticResource FluentToggleButtonStyle}"
                                  MinHeight="30"
                                  Padding="11,5"
                                  Margin="0,0,6,0"
                                  IsChecked="{Binding IsLiveRunning, Mode=OneWay}"
                                  Command="{Binding ToggleLiveCommand}"
                                  ToolTip="Автоматическая проверка топ-6 серверов каждые 2.8 сек" />
                    <Button Content="Тест скорости"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinHeight="30"
                            Padding="13,5"
                            Command="{Binding BenchmarkVisibleCommand}" />
                </StackPanel>

                <!-- Native Window Minimize / Maximize / Close -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="Свернуть" />
                    <Button Content="□" Style="{StaticResource CaptionButtonStyle}" Click="OnMaximizeRestoreClick" ToolTip="Развернуть" />
                    <Button Content="✕" Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindowClick" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Active Local Tunnel Strip -->
        <Border Grid.Row="1"
                Margin="18,12,18,0"
                Padding="14,10"
                CornerRadius="8"
                Background="{DynamicResource SelectedSurfaceBrush}"
                BorderBrush="{DynamicResource StatusOkBrush}"
                BorderThickness="1"
                Visibility="{Binding IsTunnelActive, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TunnelSummaryTitle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusOkBrush}" />
                    <TextBlock Text="{Binding TunnelSummarySubtitle}"
                               Style="{StaticResource MonoMetaStyle}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Ротация ↻"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="0,0,8,0"
                            Command="{Binding RotateTunnelCommand}"
                            ToolTip="Переключиться на следующий рабочий Smart-DNS (Ctrl+Alt+R)" />
                    <Button Content="Откл"
                            Style="{StaticResource DangerButtonStyle}"
                            MinHeight="30"
                            Padding="13,5"
                            Command="{Binding StopTunnelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Main Content Area -->
        <Grid Grid.Row="2" Margin="18,14,18,12">
            <!-- VIEW 0: ТЕСТЕР (Diagnostics + Master-Detail Inspector) -->
            <Grid Visibility="{Binding IsTesterTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Unified Target Service + Search & Filter Bar -->
                <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Target Service Header + Domain Input -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveGroupLabel, StringFormat='Режим: {0}'}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />

                                <ItemsControl ItemsSource="{Binding PresetGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}"
                                                    Margin="0,0,5,0"
                                                    Command="{Binding DataContext.SelectPresetGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonFgBrush}" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Обход 443"
                                          IsChecked="{Binding RequiresBypass}"
                                          Margin="0,0,12,0"
                                          ToolTip="Включить 4-этапный Anti-Direct-IP + TLS 443 фильтр" />
                                <TextBox Text="{Binding TargetDomain, UpdateSourceTrigger=PropertyChanged}"
                                         Width="230"
                                         MinHeight="32"
                                         Padding="10,4"
                                         FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                         FontSize="12"
                                         Tag="Домен (напр. gemini.google.com)" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick Service Presets Row -->
                        <ItemsControl ItemsSource="{Binding ActivePresets}"
                                      Margin="0,0,0,10"
                                      Visibility="{Binding IsCustomPresetGroup, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Margin="0,0,6,4"
                                            Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Subtle Hairline Divider -->
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" />

                        <!-- Search + Quick Toggles + Sort Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Поиск по названию, провайдеру, IP, DoH URL или тегам..."
                                     Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton Content="✓ Обход 443"
                                              Style="{StaticResource FluentToggleButtonStyle}"
                                              IsChecked="{Binding BypassOnly}"
                                              Margin="0,0,6,0" />
                                <ToggleButton Content="★ Избранные"
                                              Style="{StaticResource FluentToggleButtonStyle}"
                                              IsChecked="{Binding FavoritesOnly}"
                                              Margin="0,0,6,0" />
                                <ToggleButton Content="DoH / DoT"
                                              Style="{StaticResource FluentToggleButtonStyle}"
                                              IsChecked="{Binding EncryptedOnly}"
                                              Margin="0,0,6,0" />
                                <ToggleButton Content="Бесплатные"
                                              Style="{StaticResource FluentToggleButtonStyle}"
                                              IsChecked="{Binding FreeOnly}"
                                              Margin="0,0,8,0" />

                                <ComboBox Width="178"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}">
                                    <ComboBoxItem Content="Сорт: Обход + Пинг" Tag="{x:Static models:SortMode.BEST}" />
                                    <ComboBoxItem Content="Сорт: Пинг (мс)" Tag="{x:Static models:SortMode.LOWEST_PING}" />
                                    <ComboBoxItem Content="Сорт: Скорость TPS" Tag="{x:Static models:SortMode.HIGHEST_TPS}" />
                                    <ComboBoxItem Content="Сорт: Избранные" Tag="{x:Static models:SortMode.FAVORITES_FIRST}" />
                                    <ComboBoxItem Content="Сорт: По алфавиту" Tag="{x:Static models:SortMode.ALPHABETICAL}" />
                                </ComboBox>

                                <Button Content="Сброс"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding ResetFiltersCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Category Strip + Live Counter -->
                <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,0"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Name}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonFgBrush}" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Count, StringFormat='  {0}'}"
                                                   Opacity="0.7"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding VisibleSummaryText}"
                               Style="{StaticResource MonoMetaStyle}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- Master-Detail Area: Virtualized List + Collapsible Inspector -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Server List + Empty State + Show More -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 Style="{StaticResource ServerListBoxStyle}"
                                 ItemsSource="{Binding VisibleServers}"
                                 SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Semantic Status Dot -->
                                        <Ellipse Grid.Column="0"
                                                 Width="8"
                                                 Height="8"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />

                                        <!-- Server Title, Quiet Metadata, Verdict -->
                                        <StackPanel Grid.Column="1" Margin="4,0,16,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProtocolBadge, StringFormat='  ·  {0}'}"
                                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Country, StringFormat=' · {0}'}"
                                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding MetaLine}"
                                                       Style="{StaticResource MonoMetaStyle}"
                                                       FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding VerdictReason}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="460" />
                                                <TextBlock Text="{Binding JitterDisplay, StringFormat='  ·  {0}'}"
                                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Aligned Latency + Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Margin="0,0,8,0"
                                                    Padding="12,5"
                                                    MinWidth="86"
                                                    Command="{Binding DataContext.TestSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Нажмите для 4-этапной проверки узла">
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding LatencyDisplay}"
                                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding TpsDisplay}"
                                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Button>

                                            <Button Content="{Binding IsFavorite, Converter={StaticResource FavGlyph}}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    FontSize="13"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Добавить или убрать из избранного" />

                                            <Button Content="Старт"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinWidth="84"
                                                    Padding="14,6"
                                                    Command="{Binding DataContext.ToggleStartTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty Filter State -->
                        <Border Grid.Row="0"
                                Style="{StaticResource SurfaceCardStyle}"
                                Padding="36"
                                VerticalAlignment="Top"
                                Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="По текущим фильтрам серверы не найдены"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Сбросьте активные фильтры, измените поисковый запрос или добавьте собственный DNS-узел."
                                           Style="{StaticResource CaptionMutedStyle}"
                                           Margin="0,6,0,16"
                                           HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Сбросить фильтры"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding ResetFiltersCommand}" />
                                    <Button Content="Открыть Подбор" Click="OnOpenDiscoveryClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="1"
                                Content="Показать ещё (+120)"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Visibility="{Binding CanShowMore, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ShowMoreCommand}" />
                    </Grid>

                    <!-- Right: Collapsible Server Inspector Drawer -->
                    <Border Grid.Column="1"
                            Width="350"
                            Margin="14,0,0,0"
                            Padding="18"
                            Style="{StaticResource SurfaceCardStyle}"
                            Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedServer}">
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="255">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MetaLine}"
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="✕"
                                            Padding="9,4"
                                            MinHeight="28"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.CloseInspectorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DockPanel>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,14" />

                                <!-- Endpoint Copy Card -->
                                <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Адрес / Endpoint" Style="{StaticResource CaptionMutedStyle}" />
                                        <TextBlock Text="{Binding EndpointLabel}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,8" />
                                        <Button Content="Копировать адрес"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ChipButtonStyle}"
                                                Tag="{Binding EndpointLabel}"
                                                Click="OnCopyTagClick" />
                                    </StackPanel>
                                </Border>

                                <!-- Windows 11 PowerShell DoH Command -->
                                <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Команда PowerShell (Windows 11)" Style="{StaticResource CaptionMutedStyle}" />
                                        <TextBlock Text="{Binding Win11PowerShellCommand}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Копировать PS"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding Win11PowerShellCommand}"
                                                    Click="OnCopyTagClick" />
                                            <Button Content="Сеть Windows"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Click="OnOpenWinSettingsClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4-Stage Diagnostic Metrics -->
                                <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                   Text="Диагностика 4 этапов"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                            <TextBlock Text="Пинг" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding LatencyDisplay}" FontFamily="JetBrains Mono, Cascadia Mono" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Text="Джиттер / TPS" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding TpsDisplay}" FontFamily="JetBrains Mono, Cascadia Mono" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                            <TextBlock Text="Порт 443" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding Port443Display}" FontFamily="JetBrains Mono, Cascadia Mono" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Text="Полученный IP" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding ResolvedIpsDisplay}" FontFamily="JetBrains Mono, Cascadia Mono" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                                   Text="{Binding VerdictReason}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />
                                    </Grid>
                                </Border>

                                <!-- Actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Проверить сейчас"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.TestSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Старт туннель"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding DataContext.ToggleStartTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <Button Content="Удалить пользовательский сервер"
                                        Style="{StaticResource DangerButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.DeleteCustomServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 1: КАТАЛОГ (High-Density DataGrid) -->
            <Grid Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding VisibleSummaryText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Быстрый фильтр по всей базе SQLite..."
                                 Margin="0,0,12,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="+ Добавить свой DNS"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="OnOpenManualAddClick" />
                            <Button Content="Параметры сети Windows" Click="OnOpenWinSettingsClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource CatalogDataGridStyle}"
                          ItemsSource="{Binding VisibleServers}"
                          SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Статус" Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="9" Height="9" HorizontalAlignment="Center" Fill="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="210" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Протокол" Binding="{Binding ProtocolBadge}" Width="88" />
                        <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="80" />
                        <DataGridTextColumn Header="Адрес / Endpoint" Binding="{Binding EndpointLabel}" Width="*" />
                        <DataGridTextColumn Header="Пинг" Binding="{Binding LatencyDisplay}" Width="88" />
                        <DataGridTextColumn Header="TPS" Binding="{Binding TpsDisplay}" Width="92" />
                        <DataGridTemplateColumn Header="Действия" Width="178">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Тест"
                                                Style="{StaticResource ChipButtonStyle}"
                                                MinHeight="28"
                                                Padding="10,3"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.TestSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Старт"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinHeight="28"
                                                Padding="12,3"
                                                Command="{Binding DataContext.ToggleStartTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- VIEW 2: КОНФИГИ (Clean 2-Column Import, Sync & Settings) -->
            <Grid Visibility="{Binding IsConfigsTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Импорт и редактор конфигов" FontSize="15.5" FontWeight="SemiBold" />
                                <TextBlock Text="DoH, DoT, UDP, smartproxy://443, JSON и CSV с резервным сохранением в JSON-сейф"
                                           Style="{StaticResource CaptionMutedStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Загрузить файл" Margin="0,0,8,0" Click="OnLoadConfigFileClick" />
                                <Button Content="+ Добавить вручную" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenManualAddClick" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Шаблоны:" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="Smart-DNS" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,0" Command="{Binding ApplyImportTemplateCommand}" CommandParameter="smart" />
                            <Button Content="JSON" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,0" Command="{Binding ApplyImportTemplateCommand}" CommandParameter="json" />
                            <Button Content="CSV" Style="{StaticResource ChipButtonStyle}" Command="{Binding ApplyImportTemplateCommand}" CommandParameter="csv" />
                        </StackPanel>

                        <TextBox Grid.Row="2"
                                 Text="{Binding ImportEditorText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                 Padding="12" />

                        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="Импортировать в базу"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Margin="0,0,10,0"
                                        Command="{Binding ImportFromEditorCommand}" />
                                <TextBlock Text="{Binding ConfigFeedback}"
                                           Foreground="{DynamicResource StatusOkBrush}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Экспорт CSV" Margin="0,0,8,0" Click="OnExportCsvClick" />
                                <Button Content="Экспорт JSON" Click="OnExportJsonClick" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Синхронизация и база" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="Кэш доменов обхода:" Style="{StaticResource CaptionMutedStyle}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding CachedHostsCount, StringFormat='{}{0} хостов'}"
                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                               FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>

                            <Button Content="Синхронизировать онлайн-списки"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,0,8"
                                    Command="{Binding SyncFeedsCommand}" />
                            <Button Content="Восстановить встроенную базу (1050+)"
                                    Margin="0,0,0,8"
                                    Command="{Binding RestoreCatalogBuiltinsCommand}" />
                            <Button Content="Открыть Подбор / Сканер /24"
                                    Margin="0,0,0,8"
                                    Click="OnOpenDiscoveryClick" />
                            <Button Content="Параметры сети Windows" Click="OnOpenWinSettingsClick" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Оформление и фильтры" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Button Content="Переключить светлую / тёмную тему" Margin="0,0,0,10" Click="OnToggleThemeClick" />
                            <CheckBox Content="Только бесплатные безлимитные" IsChecked="{Binding FreeOnly}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Row 3: Quiet Bottom Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource WindowCaptionBgBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="90"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionMutedStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding TotalCatalogCount, StringFormat='База SQLite: {0} серверов'}"
                           Style="{StaticResource MonoMetaStyle}"
                           FontSize="11.5"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
