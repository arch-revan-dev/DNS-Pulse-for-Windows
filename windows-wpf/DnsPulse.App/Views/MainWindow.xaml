<Window x:Class="DnsPulse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Pulse" Height="860" Width="1300"
        MinHeight="700" MinWidth="1040"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="DNS Pulse" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="  •  Windows 10/11 Smart-DNS &amp; Diagnostics" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ThemeToggleBtn" Content="Тема" Padding="12,7" Margin="0,0,8,0" Click="OnToggleThemeClick" />
                <Button Content="Подбор" Padding="14,7" Margin="0,0,8,0" Click="OnOpenDiscoveryClick" />
                <Button x:Name="LiveBtn" Content="LIVE" Padding="14,7" Margin="0,0,8,0" Click="OnToggleLiveClick" />
                <Button Content="Тест скорости" Padding="16,7" Click="OnBenchmarkClick" />
            </StackPanel>
        </DockPanel>

        <!-- Active Tunnel Banner -->
        <Border Grid.Row="1"
                x:Name="TunnelBanner"
                Visibility="Collapsed"
                Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource StatusOkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TunnelBannerTitle" FontWeight="SemiBold" Foreground="{DynamicResource StatusOkBrush}" />
                    <TextBlock x:Name="TunnelBannerSubtitle" FontFamily="JetBrains Mono, Cascadia Mono" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Ротация ↻" Padding="12,6" Margin="0,0,8,0" Click="OnRotateTunnelClick" />
                    <Button Content="Откл" Padding="12,6" Background="{DynamicResource StatusErrorBrush}" Foreground="White" Click="OnStopTunnelClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Tabs: Тестер / Каталог / Конфиги -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="OnMainTabChanged">
            <TabItem Header="Тестер">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Mode & Domain Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock x:Name="ModeLabel" DockPanel.Dock="Left" Text="Режим: ИИ" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBox x:Name="DomainInput" Text="{Binding TargetDomain, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="8,4" FontFamily="JetBrains Mono, Cascadia Mono" Background="{DynamicResource SecondarySurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" />
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel>
                                <Button Content="Gemini" Padding="10,4" Margin="0,0,6,0" Tag="gemini.google.com|true|ИИ" Click="OnPresetClick" />
                                <Button Content="AI Studio" Padding="10,4" Margin="0,0,6,0" Tag="aistudio.google.com|true|ИИ" Click="OnPresetClick" />
                                <Button Content="ChatGPT" Padding="10,4" Margin="0,0,6,0" Tag="chatgpt.com|true|ИИ" Click="OnPresetClick" />
                                <Button Content="Claude" Padding="10,4" Margin="0,0,6,0" Tag="claude.ai|true|ИИ" Click="OnPresetClick" />
                                <Button Content="Spotify" Padding="10,4" Margin="0,0,6,0" Tag="open.spotify.com|true|Стриминг" Click="OnPresetClick" />
                                <Button Content="Xbox Live" Padding="10,4" Margin="0,0,6,0" Tag="login.live.com|true|Игры" Click="OnPresetClick" />
                                <Button Content="Cloudflare Ping" Padding="10,4" Tag="one.one.one.one|false|Скорость" Click="OnPresetClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Search, Quick Filters & Sort Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <TextBox DockPanel.Dock="Left" Width="260" Padding="8,5" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource SecondarySurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" ToolTip="Поиск по имени, провайдеру, IP, DoH URL" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="✓ Обход 443" IsChecked="{Binding BypassOnly}" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <CheckBox Content="★ Избранные" IsChecked="{Binding FavoritesOnly}" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <CheckBox Content="DoH / DoT" IsChecked="{Binding EncryptedOnly}" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="CategoryCombo" Width="140" Margin="0,0,8,0" SelectionChanged="OnCategoryChanged">
                                    <ComboBoxItem Content="Все" IsSelected="True" />
                                    <ComboBoxItem Content="Smart-DNS" />
                                    <ComboBoxItem Content="Скоростные" />
                                    <ComboBoxItem Content="Антиреклама" />
                                    <ComboBoxItem Content="Игры и Регионы" />
                                    <ComboBoxItem Content="Магистральные" />
                                    <ComboBoxItem Content="Свои / Найденные" />
                                </ComboBox>
                                <ComboBox x:Name="SortCombo" Width="165" SelectionChanged="OnSortChanged">
                                    <ComboBoxItem Content="Сорт: Обход + Пинг" Tag="BEST" IsSelected="True" />
                                    <ComboBoxItem Content="Сорт: Пинг (мс)" Tag="LOWEST_PING" />
                                    <ComboBoxItem Content="Сорт: Скорость TPS" Tag="HIGHEST_TPS" />
                                    <ComboBoxItem Content="Сорт: Избранные" Tag="FAVORITES_FIRST" />
                                    <ComboBoxItem Content="Сорт: По алфавиту" Tag="ALPHABETICAL" />
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Server List -->
                    <ListView Grid.Row="2" ItemsSource="{Binding VisibleServers}" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8,6" LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="680">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Protocol, StringFormat='  •  {0}'}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Country, StringFormat='  •  {0}'}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding VerdictReason}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastLatencyMs, StringFormat='{}{0} мс', TargetNullValue='—'}" FontFamily="JetBrains Mono, Cascadia Mono" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <Button Content="★" Padding="8,5" Margin="0,0,6,0" Click="OnFavoriteClick" />
                                        <Button Content="Тест" Padding="10,5" Margin="0,0,6,0" Click="OnTestSingleClick" />
                                        <Button Content="Старт" Padding="14,5" Click="OnStartTunnelClick" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Каталог">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TotalCatalogCount, StringFormat='Всего серверов в базе SQLite: {0}'}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Открыть сетевые настройки Windows" Padding="12,6" Click="OnOpenWinSettingsClick" />
                    </DockPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding VisibleServers}" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8,6" LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Provider}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding PrimaryIp}" FontFamily="JetBrains Mono, Cascadia Mono" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <Button Content="Старт" Padding="12,5" Click="OnStartTunnelClick" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Конфиги">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Импорт списков DoH / DoT / IP / JSON / CSV" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBox x:Name="ImportEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="JetBrains Mono, Cascadia Mono" Padding="10" Background="{DynamicResource SecondarySurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" Text="https://dns.bezmezhau.com/dns-query Bezmezhau Public&#x0a;https://dns.magicdns.ru/dns-query MagicDNS&#x0a;176.99.11.77 Xbox-DNS" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Импортировать в базу" Padding="16,8" Margin="0,0,8,0" Click="OnImportConfigsClick" />
                                <Button Content="Экспорт CSV" Padding="14,8" Margin="0,0,8,0" Click="OnExportCsvClick" />
                                <TextBlock x:Name="ConfigFeedbackText" VerticalAlignment="Center" Foreground="{DynamicResource StatusOkBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Синхронизация и база" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Button Content="Синхронизировать онлайн-списки" Padding="12,8" Margin="0,0,0,8" Click="OnSyncFeedsFromConfigsClick" />
                            <Button Content="Восстановить встроенную базу (1050+)" Padding="12,8" Margin="0,0,0,8" Click="OnRestoreBuiltinsClick" />
                            <Button Content="Сбросить системный кэш DNS" Padding="12,8" Click="OnOpenWinSettingsClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
