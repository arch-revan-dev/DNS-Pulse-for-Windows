<Window x:Class="DnsPulse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DnsPulse.App.Models"
        Title="DNS Pulse"
        Height="860"
        Width="1380"
        MinHeight="680"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dynamic Connect/Stop Row Button -->
        <Style x:Key="RowConnectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="Подключить" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusErrorBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Content" Value="Стоп" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Star Favorite Icon Button (Content created per-instance via ContentTemplate to avoid WPF sharing bug) -->
        <Style x:Key="FavoriteStarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Path Data="M 8,1 L 10.1,5.3 L 14.8,6 L 11.4,9.3 L 12.2,14 L 8,11.8 L 3.8,14 L 4.6,9.3 L 1.2,6 L 5.9,5.3 Z"
                              Width="15"
                              Height="15"
                              Stretch="Uniform"
                              StrokeThickness="1.3"
                              StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
                                    <Setter Property="Fill" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsFavorite, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource StatusWarnBrush}" />
                                            <Setter Property="Fill" Value="{DynamicResource StatusWarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarnBrush}" />
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Active Server Badge Pill -->
        <Style x:Key="ActiveTunnelBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqMulti}">
                            <Binding Path="Id" />
                            <Binding Path="DataContext.ActiveTunnelServerId" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Row 0: Clean Minimal Windows 11 Titlebar -->
        <Border Grid.Row="0"
                Background="{DynamicResource WindowCaptionBgBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 2,9 L 5,9 L 7,3 L 10,14 L 12.5,7 L 14.5,9 L 17,9"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="18"
                          Height="16"
                          VerticalAlignment="Center"
                          Margin="0,0,9,0" />
                    <TextBlock Text="DNS Pulse"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text=" · Windows Smart-DNS"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <!-- Active Tunnel Compact Indicator in Titlebar -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Padding="10,4"
                        CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsTunnelActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusOkBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TunnelSummaryTitle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusOkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Native-style Vector Window Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="Свернуть">
                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMaximizeRestoreClick" ToolTip="Развернуть">
                        <Rectangle Width="9.5" Height="9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseWindowClick" ToolTip="Закрыть">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: 2-Column App Shell (Navigation Rail + Workspace) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Navigation Rail + Tools + Tunnel Card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderHairlineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14,16,14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Primary Navigation -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="РАЗДЕЛЫ"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="10,0,0,8" />

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavRadioStyle}"
                                     IsChecked="{Binding IsTesterTab, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}"
                                     CommandParameter="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8,1 A 7,7 0 1 1 7.99,1 Z M 8,4.5 A 3.5,3.5 0 1 1 7.99,4.5 Z M 8,8 L 12.5,3.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Тестер и подбор" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavRadioStyle}"
                                     IsChecked="{Binding IsCatalogTab, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}"
                                     CommandParameter="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M 1,3 L 15,3 M 1,8 L 15,8 M 1,13 L 15,13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Каталог" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource BadgePillStyle}" Padding="6,1">
                                    <TextBlock Text="{Binding TotalCatalogCount}"
                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavRadioStyle}"
                                     IsChecked="{Binding IsConfigsTab, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}"
                                     CommandParameter="2">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 3,1.5 L 10.5,1.5 L 13.5,4.5 L 13.5,14.5 L 3,14.5 Z M 5.5,7.5 L 11,7.5 M 5.5,10.5 L 9.5,10.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Конфиги и база" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav"
                                     Style="{StaticResource SidebarNavRadioStyle}"
                                     IsChecked="{Binding IsSettingsTab, Mode=OneWay}"
                                     Command="{Binding SelectTabCommand}"
                                     CommandParameter="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M 8,5 A 3,3 0 1 1 7.99,5 Z M 8,1 L 8,2.8 M 8,13.2 L 8,15 M 1,8 L 2.8,8 M 13.2,8 L 15,8 M 3.05,3.05 L 4.35,4.35 M 11.65,11.65 L 12.95,12.95 M 12.95,3.05 L 11.65,4.35 M 4.35,11.65 L 3.05,12.95"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Настройки" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="2"
                                         Width="7"
                                         Height="7"
                                         Fill="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Доступно обновление" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!-- Quick Tools -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="ИНСТРУМЕНТЫ"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="10,0,0,8" />

                        <Button Style="{StaticResource SidebarActionButtonStyle}" Click="OnOpenDiscoveryClick" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8,1 L 8,15 M 1,8 L 15,8 M 3,3 L 13,13 M 13,3 L 3,13"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Сканер /24 и списки" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarActionButtonStyle}" Click="OnOpenManualAddClick" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8,2 L 8,14 M 2,8 L 14,8"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Добавить свой DNS" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarActionButtonStyle}" Click="OnOpenWinSettingsClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2,4 L 14,4 L 14,12 L 2,12 Z M 5,14.5 L 11,14.5 M 8,12 L 8,14.5"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Сеть Windows" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Row 2 Spacer -->
                    <Grid Grid.Row="2" />

                    <!-- Row 3: Persistent Tunnel Control Card -->
                    <Grid Grid.Row="3" Margin="0,12,0,12">
                        <!-- Disconnected State -->
                        <Border Style="{StaticResource SurfaceCardStyle}"
                                Padding="14"
                                Visibility="{Binding IsTunnelActive, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusNeutralBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Туннель отключён" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding TargetDomain, StringFormat='Цель: {0}'}"
                                           Style="{StaticResource MonoMetaStyle}"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,12" />
                                <Button Content="Подключить лучший"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ConnectBestCommand}"
                                        ToolTip="Автоматически подобрать и запустить самый быстрый рабочий Smart-DNS" />
                            </StackPanel>
                        </Border>

                        <!-- Active State -->
                        <Border Background="{DynamicResource SelectedSurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Visibility="{Binding IsTunnelActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusOkBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Туннель активен"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatusOkBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveTunnelServer.Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />
                                <TextBlock Text="{Binding TunnelSummarySubtitle}"
                                           Style="{StaticResource MonoMetaStyle}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Ротация"
                                            Style="{StaticResource ChipButtonStyle}"
                                            MinHeight="32"
                                            Command="{Binding RotateTunnelCommand}"
                                            ToolTip="Переключить на следующий рабочий узел (Ctrl+Alt+R)" />
                                    <Button Grid.Column="2"
                                            Content="Откл"
                                            Style="{StaticResource DangerButtonStyle}"
                                            MinHeight="32"
                                            Padding="10,5"
                                            Command="{Binding StopTunnelCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Theme Switcher Footer -->
                    <Border Grid.Row="4"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0">
                        <Button x:Name="ThemeToggleBtn"
                                Style="{StaticResource SidebarActionButtonStyle}"
                                Click="OnToggleThemeClick"
                                ToolTip="Переключить светлую или тёмную тему">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8,2 A 6,6 0 1 0 14,8 A 4.5,4.5 0 1 1 8,2 Z"
                                      Stroke="{DynamicResource MutedTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ThemeLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT WORKSPACE -->
            <Grid Grid.Column="1" Margin="22,16,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Global In-App Auto-Update Banner (visible when GitHub release > current version) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="Скачать и обновить сейчас"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinHeight="30"
                                        Padding="14,4"
                                        Margin="0,0,8,0"
                                        IsEnabled="{Binding IsUpdatingApp, Converter={StaticResource InverseBool}}"
                                        Command="{Binding InstallAppUpdateCommand}" />
                                <Button Style="{StaticResource ChipButtonStyle}"
                                        MinHeight="30"
                                        Padding="8,4"
                                        ToolTip="Скрыть уведомление"
                                        Visibility="{Binding IsUpdatingApp, Converter={StaticResource InverseBoolToVis}}"
                                        Command="{Binding DismissUpdateBannerCommand}">
                                    <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                          Stroke="{DynamicResource MutedTextBrush}"
                                          StrokeThickness="1.4"
                                          Width="10"
                                          Height="10" />
                                </Button>
                            </StackPanel>

                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <Path DockPanel.Dock="Left"
                                      Data="M 8,2 L 8,10.5 M 4.5,7.5 L 8,11 L 11.5,7.5 M 2.5,13.5 L 13.5,13.5"
                                      Stroke="{DynamicResource StatusOkBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpdateBannerText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatusOkBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DockPanel>

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsUpdatingApp, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Value="{Binding UpdateProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource MonoMetaStyle}" FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SHARED MASTER-DETAIL FOR TESTER & CATALOG -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfigsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSettingsTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT TAB CONTENT (TESTER OR CATALOG) -->
                    <Grid Grid.Column="0">
                        <!-- VIEW 0: ТЕСТЕР -->
                        <Grid Visibility="{Binding IsTesterTab, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header + Primary Benchmark Actions -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <!-- UAC / Admin Notice Banner (only shown if not elevated) -->
                                <Border Background="{DynamicResource WarnSoftBrush}"
                                        BorderBrush="{DynamicResource StatusWarnBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding NeedsElevationForSystemDns, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="Перезапустить от админа"
                                                Style="{StaticResource ChipButtonStyle}"
                                                MinHeight="28"
                                                Padding="10,4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding RestartAsAdminCommand}" />
                                        <TextBlock Text="Запуск без прав администратора: тесты и сканер работают сразу, но для автопереключения DNS Windows требуется UAC."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource StatusWarnBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <ToggleButton Style="{StaticResource FluentToggleButtonStyle}"
                                                      IsChecked="{Binding AutoModeEnabled, Mode=OneWay}"
                                                      Command="{Binding ToggleAutoModeCommand}"
                                                      Padding="11,6"
                                                      Margin="0,0,6,0"
                                                      ToolTip="Автоматически проверить кандидатов, выбрать лучший рабочий узел и сразу переключить системный DNS (с автозаменой при сбое)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M 8,1 L 3,8.5 L 7.5,8.5 L 6.5,14 L 12.5,6.5 L 8,6.5 Z"
                                                      Fill="{DynamicResource AccentBrush}"
                                                      Width="13"
                                                      Height="14"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AutoModeLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>

                                        <ToggleButton Style="{StaticResource FluentToggleButtonStyle}"
                                                      IsChecked="{Binding IsLiveRunning, Mode=OneWay}"
                                                      Command="{Binding ToggleLiveCommand}"
                                                      Padding="11,6"
                                                      Margin="0,0,6,0"
                                                      ToolTip="Автоматическая проверка топ-6 серверов каждые 3 сек">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusOkBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="LIVE" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>

                                        <Button Content="{Binding BenchmarkButtonText}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="13,7"
                                                Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource InverseBoolToVis}}"
                                                Command="{Binding BenchmarkVisibleCommand}"
                                                ToolTip="Проверить абсолютно все DNS в открытой категории / фильтре" />

                                        <Button Content="Остановить тест"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="13,7"
                                                Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding StopBenchmarkCommand}" />
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Диагностика и подбор" Style="{StaticResource PageTitleStyle}" />
                                        <TextBlock Text="{Binding ModeExplanationText}"
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Value="{Binding BenchmarkProgressPercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="4"
                                                 Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding BenchmarkProgressText}"
                                               Style="{StaticResource MonoMetaStyle}"
                                               FontSize="11.5" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Clean 2-Tier Target & Filter Card -->
                            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Tier 1: Target Service Group + Domain Input -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <DockPanel Grid.Column="0" LastChildFill="True" VerticalAlignment="Center" MaxWidth="360">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="Сервис:"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,4" />
                                            <ItemsControl ItemsSource="{Binding PresetGroups}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}"
                                                                Margin="0,0,6,4"
                                                                Command="{Binding DataContext.SelectPresetGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonFgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>

                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <CheckBox Content="Сплит-туннель (только ИИ/обход)"
                                                      IsChecked="{Binding SplitTunnelEnabled}"
                                                      Margin="0,2,12,2"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Направляет через Smart-DNS только заблокированные ИИ/сервисы, а обычный интернет (VK, банки, загрузки) пускает напрямую через 1.1.1.1" />
                                            <CheckBox Content="Обход 443"
                                                      IsChecked="{Binding RequiresBypass}"
                                                      Margin="0,2,10,2"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Включить 4-этапный Anti-Direct-IP + TLS 443 фильтр" />
                                            <TextBox Text="{Binding TargetDomain, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="175"
                                                     MaxWidth="220"
                                                     Margin="0,2,0,2"
                                                     FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                     FontSize="12.5"
                                                     Tag="gemini.google.com" />
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Quick Presets WrapPanel -->
                                    <ItemsControl ItemsSource="{Binding ActivePresets}"
                                                  Margin="0,0,0,6"
                                                  Visibility="{Binding IsCustomPresetGroup, Converter={StaticResource InverseBoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}"
                                                        Margin="0,0,6,6"
                                                        Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,12" />

                                    <!-- Tier 2: Search + Quick Filters + Sort -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,10,0">
                                            <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Поиск: название, страна, IP, DoH URL (несколько слов)..." />
                                            <Button HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    MinHeight="24"
                                                    Padding="7,5"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Visibility="{Binding SearchQuery, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding ClearSearchCommand}"
                                                    ToolTip="Очистить поиск">
                                                <Path Data="M 1,1 L 8,8 M 8,1 L 1,8"
                                                      Stroke="{DynamicResource MutedTextBrush}"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="9"
                                                      Height="9" />
                                            </Button>
                                        </Grid>

                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Content="Рабочие 443"
                                                          Style="{StaticResource FluentToggleButtonStyle}"
                                                          IsChecked="{Binding BypassOnly}"
                                                          Margin="0,0,6,0" />
                                            <ToggleButton Content="Избранные"
                                                          Style="{StaticResource FluentToggleButtonStyle}"
                                                          IsChecked="{Binding FavoritesOnly}"
                                                          Margin="0,0,6,0" />
                                            <ToggleButton Content="DoH / DoT"
                                                          Style="{StaticResource FluentToggleButtonStyle}"
                                                          IsChecked="{Binding EncryptedOnly}"
                                                          Margin="0,0,6,0" />
                                            <ToggleButton Content="Бесплатные"
                                                          Style="{StaticResource FluentToggleButtonStyle}"
                                                          IsChecked="{Binding FreeOnly}"
                                                          Margin="0,0,8,0" />

                                            <ComboBox MinWidth="176"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}">
                                                <ComboBoxItem Content="Сорт: Обход + Пинг" Tag="{x:Static models:SortMode.BEST}" />
                                                <ComboBoxItem Content="Сорт: Пинг (мс)" Tag="{x:Static models:SortMode.LOWEST_PING}" />
                                                <ComboBoxItem Content="Сорт: Скорость TPS" Tag="{x:Static models:SortMode.HIGHEST_TPS}" />
                                                <ComboBoxItem Content="Сорт: Избранные" Tag="{x:Static models:SortMode.FAVORITES_FIRST}" />
                                                <ComboBoxItem Content="Сорт: По алфавиту" Tag="{x:Static models:SortMode.ALPHABETICAL}" />
                                            </ComboBox>

                                            <Button Content="Сброс"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    MinHeight="36"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding ResetFiltersCommand}" />
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Category Chips + Summary -->
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6"
                                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Name}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonFgBrush}" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Count, StringFormat='  {0}'}"
                                                               Opacity="0.65"
                                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding VisibleSummaryText}"
                                           Style="{StaticResource MonoMetaStyle}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,6" />
                            </Grid>

                            <!-- Virtualized Server Cards List + Empty State + Show More -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         Style="{StaticResource ServerListBoxStyle}"
                                         ItemsSource="{Binding VisibleServers}"
                                         SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding DataContext.ServerRowPadding, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Semantic Status Dot -->
                                                <Ellipse Grid.Column="0"
                                                         Width="9"
                                                         Height="9"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />

                                                <!-- Center Info Block -->
                                                <StackPanel Grid.Column="1" Margin="6,0,16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource BadgePillStyle}" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding ProtocolBadge}"
                                                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Country, StringFormat='  {0}'}"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource ActiveTunnelBadgeStyle}">
                                                            <TextBlock Text="АКТИВЕН"
                                                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource StatusOkBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding MetaLine}"
                                                               Style="{StaticResource MonoMetaStyle}"
                                                               FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0" />

                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding VerdictReason}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding JitterDisplay, StringFormat='  ·  {0}'}"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right Aligned Metrics & Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Margin="0,0,8,0"
                                                            Padding="12,5"
                                                            MinWidth="88"
                                                            MinHeight="38"
                                                            Command="{Binding DataContext.TestSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Нажмите для 4-этапной проверки узла">
                                                        <StackPanel HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding LatencyDisplay}"
                                                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding TpsDisplay}"
                                                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Style="{StaticResource FavoriteStarButtonStyle}"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Добавить или убрать из избранного" />

                                                    <Button Style="{StaticResource RowConnectButtonStyle}"
                                                            Command="{Binding DataContext.ToggleStartTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Tag>
                                                            <MultiBinding Converter="{StaticResource EqMulti}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.ActiveTunnelServerId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Button.Tag>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty Filter State -->
                                <Border Grid.Row="0"
                                        Style="{StaticResource SurfaceCardStyle}"
                                        Padding="40"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="По текущим фильтрам серверы не найдены"
                                                   FontSize="15.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Сбросьте активные фильтры, измените поисковый запрос или добавьте собственный DNS-узел."
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   Margin="0,6,0,18"
                                                   HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Сбросить фильтры"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding ResetFiltersCommand}" />
                                            <Button Content="Открыть сканер /24" Click="OnOpenDiscoveryClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Row="1"
                                        Content="Показать ещё (+120)"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding CanShowMore, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding ShowMoreCommand}" />
                            </Grid>
                        </Grid>

                        <!-- VIEW 1: КАТАЛОГ (High-Density DataGrid) -->
                        <Grid Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Content="{Binding BenchmarkButtonText}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="13,7"
                                            Margin="0,0,6,0"
                                            Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource InverseBoolToVis}}"
                                            Command="{Binding BenchmarkVisibleCommand}"
                                            ToolTip="Проверить все DNS, показанные в текущем разделе/фильтре" />
                                    <Button Content="Остановить тест"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="13,7"
                                            Margin="0,0,6,0"
                                            Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding StopBenchmarkCommand}" />
                                    <Button Content="+ Добавить свой DNS"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="13,7"
                                            Margin="0,0,6,0"
                                            Click="OnOpenManualAddClick" />
                                    <Button Content="Параметры сети Windows" Padding="12,7" Click="OnOpenWinSettingsClick" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Каталог серверов" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="{Binding VisibleSummaryText}"
                                               Style="{StaticResource CaptionMutedStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Быстрый фильтр по всей базе SQLite (несколько слов)..." />
                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                MinHeight="24"
                                                Padding="7,5"
                                                Style="{StaticResource ChipButtonStyle}"
                                                Visibility="{Binding SearchQuery, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding ClearSearchCommand}"
                                                ToolTip="Очистить поиск">
                                            <Path Data="M 1,1 L 8,8 M 8,1 L 1,8"
                                                  Stroke="{DynamicResource MutedTextBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="9"
                                                  Height="9" />
                                        </Button>
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Content="Сброс"
                                            Style="{StaticResource ChipButtonStyle}"
                                            MinHeight="36"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding ResetFiltersCommand}" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2"
                                      Style="{StaticResource CatalogDataGridStyle}"
                                      ItemsSource="{Binding VisibleServers}"
                                      SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Статус" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="9" Height="9" HorizontalAlignment="Center" Fill="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="210" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Протокол" Binding="{Binding ProtocolBadge}" Width="88" />
                                    <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="80" />
                                    <DataGridTextColumn Header="Адрес / Endpoint" Binding="{Binding EndpointLabel}" Width="*" />
                                    <DataGridTextColumn Header="Пинг" Binding="{Binding LatencyDisplay}" Width="86" />
                                    <DataGridTextColumn Header="TPS" Binding="{Binding TpsDisplay}" Width="88" />
                                    <DataGridTemplateColumn Header="Действия" Width="196">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Тест"
                                                            Style="{StaticResource ChipButtonStyle}"
                                                            MinHeight="30"
                                                            Padding="10,4"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.TestSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource RowConnectButtonStyle}"
                                                            MinWidth="92"
                                                            MinHeight="30"
                                                            Padding="10,4"
                                                            Command="{Binding DataContext.ToggleStartTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Tag>
                                                            <MultiBinding Converter="{StaticResource EqMulti}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.ActiveTunnelServerId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Button.Tag>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- SHARED RIGHT INSPECTOR DRAWER (Tester + Catalog) -->
                    <Border Grid.Column="1"
                            Width="332"
                            Margin="14,0,0,0"
                            Padding="16"
                            Style="{StaticResource ElevatedCardStyle}"
                            Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedServer}">
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="248">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MetaLine}"
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.CloseInspectorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Закрыть инспектор">
                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{DynamicResource MutedTextBrush}"
                                              StrokeThickness="1.5"
                                              Width="9"
                                              Height="9" />
                                    </Button>
                                </DockPanel>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,14" />

                                <!-- Endpoint Copy Card -->
                                <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="13"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Адрес / Endpoint" Style="{StaticResource CaptionMutedStyle}" />
                                        <TextBlock Text="{Binding EndpointLabel}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,10" />
                                        <Button Content="Копировать адрес"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource ChipButtonStyle}"
                                                Tag="{Binding EndpointLabel}"
                                                Click="OnCopyTagClick" />
                                    </StackPanel>
                                </Border>

                                <!-- Windows 11 PowerShell DoH Command -->
                                <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="13"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Команда PowerShell (Windows 11)" Style="{StaticResource CaptionMutedStyle}" />
                                        <TextBlock Text="{Binding Win11PowerShellCommand}"
                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Копировать PS"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding Win11PowerShellCommand}"
                                                    Click="OnCopyTagClick" />
                                            <Button Content="Сеть Windows"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Click="OnOpenWinSettingsClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4-Stage Diagnostic Metrics -->
                                <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="13"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                   Text="Диагностика 4 этапов"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Пинг" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding LatencyDisplay}" FontFamily="JetBrains Mono, Cascadia Mono" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="Джиттер / TPS" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding TpsDisplay}" FontFamily="JetBrains Mono, Cascadia Mono" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Порт 443" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding Port443Display}" FontFamily="JetBrains Mono, Cascadia Mono" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="Полученный IP" Style="{StaticResource CaptionMutedStyle}" />
                                            <TextBlock Text="{Binding ResolvedIpsDisplay}" FontFamily="JetBrains Mono, Cascadia Mono" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                                   Text="{Binding VerdictReason}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />
                                    </Grid>
                                </Border>

                                <!-- Primary Inspector Actions -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="Проверить"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.TestSingleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource RowConnectButtonStyle}"
                                            Command="{Binding DataContext.ToggleStartTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource EqMulti}">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.ActiveTunnelServerId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </Grid>

                                <Button Content="Удалить пользовательский сервер"
                                        Style="{StaticResource DangerButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.DeleteCustomServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- VIEW 2: КОНФИГИ И БАЗА -->
                <Grid Grid.Row="1" Visibility="{Binding IsConfigsTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Content="Загрузить файл" Margin="0,0,8,0" Click="OnLoadConfigFileClick" />
                            <Button Content="+ Добавить вручную" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenManualAddClick" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Конфиги и управление базой" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Пакетный импорт DoH, DoT, UDP, SNI-Proxy 443, JSON и CSV с резервным JSON-сейфом"
                                       Style="{StaticResource CaptionMutedStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- Import Editor Card -->
                        <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Редактор пакетного импорта"
                                               Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Шаблоны:" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="Smart-DNS" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,0" Command="{Binding ApplyImportTemplateCommand}" CommandParameter="smart" />
                                        <Button Content="JSON" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,0" Command="{Binding ApplyImportTemplateCommand}" CommandParameter="json" />
                                        <Button Content="CSV" Style="{StaticResource ChipButtonStyle}" Command="{Binding ApplyImportTemplateCommand}" CommandParameter="csv" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBox Grid.Row="1"
                                         Text="{Binding ImportEditorText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                         FontSize="12.5"
                                         Padding="14" />

                                <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Content="Импортировать в базу"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Margin="0,0,12,0"
                                                Command="{Binding ImportFromEditorCommand}" />
                                        <TextBlock Text="{Binding ConfigFeedback}"
                                                   Foreground="{DynamicResource StatusOkBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Экспорт CSV" Margin="0,0,8,0" Click="OnExportCsvClick" />
                                        <Button Content="Экспорт JSON" Click="OnExportJsonClick" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- Right Scrollable Settings & Sync Column -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Синхронизация и база" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                        <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderHairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,14">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="Кэш доменов обхода:" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CachedHostsCount, StringFormat='{}{0} хостов'}"
                                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>

                                        <Button Content="Синхронизировать онлайн-списки"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                Command="{Binding SyncFeedsCommand}" />
                                        <Button Content="Восстановить встроенную базу (1050+)"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                Command="{Binding RestoreCatalogBuiltinsCommand}" />
                                        <Button Content="Открыть сканер подсетей /24"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                Click="OnOpenDiscoveryClick" />
                                        <Button Content="Параметры сети Windows"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,12"
                                                Click="OnOpenWinSettingsClick" />
                                        <CheckBox Content="Только бесплатные безлимитные" IsChecked="{Binding FreeOnly}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- VIEW 3: НАСТРОЙКИ -->
                <Grid Grid.Row="1" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                        <Border DockPanel.Dock="Right" Style="{StaticResource BadgePillStyle}" Padding="10,4" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{Binding CurrentVersionText, StringFormat='DNS Pulse {0}'}"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Настройки и кастомизация" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Обновления с GitHub, надёжный автозапуск Windows, поведение трея, авторежим и параметры туннеля"
                                       Style="{StaticResource CaptionMutedStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Autostart, Tray, Auto Mode, Network -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <!-- Autostart & Tray -->
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Path Data="M 8,1.5 L 8,8 M 4.2,3.4 A 5.8,5.8 0 1 0 11.8,3.4"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Автозапуск и системный трей" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <CheckBox Content="Запускать DNS Pulse автоматически вместе с Windows (HKCU Run)"
                                                  IsChecked="{Binding StartWithWindows}"
                                                  Margin="0,0,0,8" />
                                        <CheckBox Content="При автозапуске запускать свёрнутым в трей (--minimized)"
                                                  IsChecked="{Binding StartMinimizedToTray}"
                                                  IsEnabled="{Binding StartWithWindows}"
                                                  Margin="0,0,0,8" />
                                        <CheckBox Content="При нажатии «✕» сворачивать в трей (если снято — полностью завершать процесс)"
                                                  IsChecked="{Binding MinimizeToTrayOnClose}"
                                                  Margin="0,0,0,12" />

                                        <Border Background="{DynamicResource SecondarySurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderHairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,0,0,12">
                                            <TextBlock Text="{Binding AutostartStatusText}"
                                                       Style="{StaticResource MonoMetaStyle}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <WrapPanel>
                                            <Button Content="Проверить запись автозапуска"
                                                    Margin="0,0,8,4"
                                                    Command="{Binding VerifyAutostartCommand}" />
                                            <Button Content="Выйти из программы полностью"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Margin="0,0,0,4"
                                                    Click="OnExitCompletelyClick"
                                                    ToolTip="Остановить туннель, восстановить системный DNS и полностью завершить процесс DnsPulse.exe" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Auto Mode -->
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Path Data="M 8,1 L 3,8.5 L 7.5,8.5 L 6.5,14 L 12.5,6.5 L 8,6.5 Z"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Width="15"
                                                  Height="15"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Авторежим (автоподбор и переключение)" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="При включении сам проверяет доступные узлы для выбранного сервиса (и запускает сканер при необходимости), выбирает самый быстрый рабочий и сразу включает туннель."
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />

                                        <CheckBox Content="Включить Авторежим (автоматический старт и подбор лучшего DNS)"
                                                  IsChecked="{Binding AutoModeEnabled}"
                                                  Margin="0,0,0,8" />
                                        <CheckBox Content="Автопереключение (failover) при сбое или блокировке текущего узла"
                                                  IsChecked="{Binding AutoFailoverOnDrop}"
                                                  Margin="0,0,0,12" />

                                        <Button Content="{Binding AutoModeLabel}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Left"
                                                IsEnabled="{Binding IsAutoModeRunning, Converter={StaticResource InverseBool}}"
                                                Command="{Binding ToggleAutoModeCommand}" />
                                    </StackPanel>
                                </Border>

                                <!-- Network, Tunnel & Diagnostics -->
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Path Data="M 2,8 A 6,6 0 1 1 14,8 A 6,6 0 1 1 2,8 M 2.5,8 L 13.5,8 M 8,2 C 10.2,4.5 10.2,11.5 8,14 C 5.8,11.5 5.8,4.5 8,2"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Сеть, туннель и диагностика" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <CheckBox Content="Умный сплит-туннель (через Smart-DNS только домены обхода)"
                                                  IsChecked="{Binding SplitTunnelEnabled}"
                                                  Margin="0,0,0,8" />
                                        <CheckBox Content="Блокировать IPv6 (AAAA и HTTPS/SVCB) на доменах обхода против утечек"
                                                  IsChecked="{Binding BlockIpv6OnBypass}"
                                                  Margin="0,0,0,8" />
                                        <CheckBox Content="Автосинхронизация онлайн-списков (malw.link, QuickDNS) при запуске"
                                                  IsChecked="{Binding AutoSyncFeedsOnStartup}"
                                                  Margin="0,0,0,14" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Bootstrap DNS (для DoH/DoT и фидов):" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding BootstrapDnsOptions}"
                                                      SelectedItem="{Binding BootstrapDnsProvider}"
                                                      MinHeight="32" />
                                        </Grid>

                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Left" Text="Таймаут запросов диагностики" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProbeTimeoutMs, StringFormat='{}{0} мс'}" Style="{StaticResource MonoMetaStyle}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <Slider Minimum="1000" Maximum="6000" TickFrequency="200" IsSnapToTickEnabled="True" Value="{Binding ProbeTimeoutMs}" />
                                        </StackPanel>

                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Left" Text="Потоки параллельного тестирования" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BenchmarkConcurrency, StringFormat='{}{0} потоков'}" Style="{StaticResource MonoMetaStyle}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <Slider Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BenchmarkConcurrency}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT COLUMN: GitHub Updates, Customization, Infrastructure Info -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <!-- Updates -->
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                <Path Data="M 8,2 L 8,10.5 M 4.5,7.5 L 8,11 L 11.5,7.5 M 2.5,13.5 L 13.5,13.5"
                                                      Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="16"
                                                      Height="16"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="Обновления с GitHub" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgePillStyle}">
                                                <TextBlock Text="{Binding CurrentVersionText}"
                                                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DockPanel>

                                        <CheckBox Content="Автоматически проверять обновления при запуске"
                                                  IsChecked="{Binding AutoCheckUpdates}"
                                                  Margin="0,0,0,10" />

                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="GitHub Token (необязательно — только для приватного репозитория):"
                                                       Style="{StaticResource CaptionMutedStyle}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Text="{Binding GitHubToken, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                                     FontSize="12"
                                                     Tag="ghp_... (для public-репо оставьте пустым)" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding UpdateStatusText}"
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />

                                        <ProgressBar Value="{Binding UpdateProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="5"
                                                     Margin="0,0,0,10"
                                                     Visibility="{Binding IsUpdatingApp, Converter={StaticResource BoolToVis}}" />

                                        <WrapPanel>
                                            <Button Content="Проверить обновления"
                                                    Margin="0,0,8,4"
                                                    IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding CheckForUpdatesCommand}" />
                                            <Button Content="Скачать и обновить в 1 клик"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Margin="0,0,0,4"
                                                    Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding IsUpdatingApp, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding InstallAppUpdateCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Customization -->
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Кастомизация интерфейса" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

                                        <Button Content="{Binding ThemeLabel}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,12"
                                                Click="OnToggleThemeClick" />

                                        <CheckBox Content="Компактный режим карточек серверов"
                                                  IsChecked="{Binding CompactMode}"
                                                  Margin="0,0,0,14" />

                                        <TextBlock Text="Акцентный цвет интерфейса:"
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   Margin="0,0,0,8" />

                                        <WrapPanel Margin="0,0,0,14">
                                            <Button Content="Изумруд"
                                                    Margin="0,0,6,6"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Command="{Binding SelectAccentPresetCommand}"
                                                    CommandParameter="Emerald" />
                                            <Button Content="Небесный"
                                                    Margin="0,0,6,6"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Command="{Binding SelectAccentPresetCommand}"
                                                    CommandParameter="Azure" />
                                            <Button Content="Фиолетовый"
                                                    Margin="0,0,6,6"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Command="{Binding SelectAccentPresetCommand}"
                                                    CommandParameter="Violet" />
                                            <Button Content="Янтарный"
                                                    Margin="0,0,6,6"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Command="{Binding SelectAccentPresetCommand}"
                                                    CommandParameter="Amber" />
                                            <Button Content="Рубин"
                                                    Margin="0,0,0,6"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Command="{Binding SelectAccentPresetCommand}"
                                                    CommandParameter="Rose" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding AccentPreset, StringFormat='Выбранный акцент: {0}'}"
                                                   Style="{StaticResource MonoMetaStyle}"
                                                   Margin="0,0,0,12" />

                                        <Button Content="Сбросить настройки по умолчанию"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding ResetAllSettingsCommand}" />
                                    </StackPanel>
                                </Border>

                                <!-- Infrastructure Tips -->
                                <Border Style="{StaticResource SurfaceCardStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Почему срабатывают единицы узлов для Gemini / AI Studio" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                                        <TextBlock Text="Публичные Smart-DNS массово фильтруются провайдерами или получают анти-фрод/геоблок Google (403 / available-regions), если IP скомпрометирован или утекает IPv6/RPC (alkalimakersuite-pa). Встроены прямые SNI-443 узлы (GeoHide + Community SNI) и расширенный сканер /24 (~1150 адресов), а Авторежим автоматически находит и включает рабочий канал."
                                                   Style="{StaticResource CaptionMutedStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 2: Quiet Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource WindowCaptionBgBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="96"
                                 Height="4"
                                 IsIndeterminate="True"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionMutedStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+Alt+R · ротация"
                               Style="{StaticResource MonoMetaStyle}"
                               FontSize="11"
                               Opacity="0.7"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentVersionText}"
                               Style="{StaticResource MonoMetaStyle}"
                               FontSize="11"
                               Opacity="0.8"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCatalogCount, StringFormat='SQLite: {0} узлов'}"
                               Style="{StaticResource MonoMetaStyle}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
