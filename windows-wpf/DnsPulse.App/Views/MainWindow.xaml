<Window x:Class="DnsPulse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Pulse" Height="820" Width="1260"
        MinHeight="680" MinWidth="1024"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="DNS Pulse" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="  •  Windows 10/11 Smart-DNS &amp; Diagnostics" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Подбор" Padding="16,8" Margin="0,0,8,0" Click="OnOpenDiscoveryClick" />
                <Button Content="LIVE" Padding="16,8" Margin="0,0,8,0" Click="OnToggleLiveClick" />
                <Button Content="Тест скорости" Padding="16,8" Click="OnBenchmarkClick" />
            </StackPanel>
        </DockPanel>

        <!-- Mode Header with compact left label and right trimmed domain badge -->
        <Border Grid.Row="1" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Режим: ИИ" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Background="{DynamicResource SecondarySurfaceBrush}" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{Binding TargetDomain, StringFormat='{}{0} ✎'}" FontFamily="JetBrains Mono, Cascadia Mono" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Server List -->
        <ListView Grid.Row="2" ItemsSource="{Binding VisibleServers}" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="8,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding VerdictReason}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastLatencyMs, StringFormat='{}{0} мс'}" FontFamily="JetBrains Mono, Cascadia Mono" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Button Content="Старт" Padding="14,6" Click="OnStartTunnelClick" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
