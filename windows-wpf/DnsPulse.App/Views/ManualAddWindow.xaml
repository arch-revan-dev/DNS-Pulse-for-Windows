<Window x:Class="DnsPulse.App.Views.ManualAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить свой DNS — DNS Pulse"
        Width="540"
        MinWidth="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource WindowCaptionBgBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Добавить собственный DNS-сервер" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource CaptionCloseButtonStyle}"
                        Click="OnCancelClick"
                        ToolTip="Закрыть">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"
                          Width="10"
                          Height="10" />
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Название сервера" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="NameInput" Tag="Например: Мой Smart-DNS узел" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Протокол" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="ProtocolCombo" SelectedIndex="0">
                    <ComboBoxItem Content="DoH (HTTPS /dns-query)" Tag="DoH" />
                    <ComboBoxItem Content="DoT (DNS-over-TLS 853)" Tag="DoT" />
                    <ComboBoxItem Content="UDP 53 (IPv4)" Tag="UDP" />
                    <ComboBoxItem Content="SNI-Proxy 443 (smartproxy://)" Tag="SNI443" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Адрес (DoH URL, DoT Host или IPv4)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="EndpointInput"
                         FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                         Tag="https://dns.bezmezhau.com/dns-query или 176.99.11.77" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="Провайдер / заметка (необязательно)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="ProviderInput" Tag="Пользовательский" />
            </StackPanel>

            <CheckBox x:Name="BypassCheck"
                      Grid.Row="4"
                      Content="Предназначен для обхода (Smart-DNS / 443)"
                      IsChecked="True"
                      Margin="0,0,0,12" />

            <TextBlock x:Name="ErrorText"
                       Grid.Row="5"
                       Foreground="{DynamicResource StatusErrorBrush}"
                       FontSize="12.5"
                       FontWeight="Medium"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <DockPanel Grid.Row="6" LastChildFill="False" Margin="0,6,0,0">
                <Button DockPanel.Dock="Left" Content="Отмена" MinWidth="104" Click="OnCancelClick" />
                <Button DockPanel.Dock="Right" Content="Сохранить в базу" MinWidth="160" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
