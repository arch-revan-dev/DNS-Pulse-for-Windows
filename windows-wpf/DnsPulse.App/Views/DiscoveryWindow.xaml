<Window x:Class="DnsPulse.App.Views.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подбор и сканер DNS — DNS Pulse"
        Height="640"
        Width="780"
        MinHeight="520"
        MinWidth="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Dialog Titlebar -->
        <Border Grid.Row="0"
                Background="{DynamicResource WindowCaptionBgBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="Подбор рабочих DNS и SNI-прокси"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Style="{StaticResource CaptionCloseButtonStyle}"
                        Height="42"
                        Click="OnCloseClick" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Target Domain & Presets -->
            <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Целевой сервис / домен проверки" Style="{StaticResource CaptionMutedStyle}" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Gemini" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,4" Tag="gemini.google.com" Click="OnPresetDomainClick" />
                        <Button Content="AI Studio" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,4" Tag="aistudio.google.com" Click="OnPresetDomainClick" />
                        <Button Content="ChatGPT" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,4" Tag="chatgpt.com" Click="OnPresetDomainClick" />
                        <Button Content="Claude" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,4" Tag="claude.ai" Click="OnPresetDomainClick" />
                        <Button Content="Spotify" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,4" Tag="open.spotify.com" Click="OnPresetDomainClick" />
                        <Button Content="Xbox Live" Style="{StaticResource ChipButtonStyle}" Margin="0,0,6,4" Tag="login.live.com" Click="OnPresetDomainClick" />
                        <Button Content="Brawl Stars" Style="{StaticResource ChipButtonStyle}" Margin="0,0,0,4" Tag="game.brawlstarsgame.com" Click="OnPresetDomainClick" />
                    </WrapPanel>
                    <TextBox x:Name="TargetDomainInput"
                             FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                             Tag="gemini.google.com" />
                </StackPanel>
            </Border>

            <!-- Online Sync & /24 Subnet Scanner -->
            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Онлайн-источники (malw.link, QuickDNS)" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Загружает актуальные списки доменов и проверяет узлы" Style="{StaticResource CaptionMutedStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="SyncFeedsBtn"
                                DockPanel.Dock="Right"
                                Content="Парсер + проверка"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnSyncFeedsClick" />
                    </DockPanel>

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />

                    <TextBlock Text="Сканер подсетей /24 и открытых SNI-прокси (порт 443)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SubnetInput"
                                 Grid.Column="0"
                                 Text="AUTO"
                                 FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                 Tag="AUTO или подсеть вида 192.255.159.0/24" />
                        <Button x:Name="ScanBtn"
                                Grid.Column="2"
                                Content="Сканировать"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnScanClick" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ScanUdp53Check" Content="Сканировать UDP 53 (Smart-DNS)" IsChecked="True" Margin="0,0,18,0" />
                        <CheckBox x:Name="CheckPort443Check" Content="Проверять порт 443 (SNI-прокси)" IsChecked="True" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="ScanProgress" Grid.Row="2" Minimum="0" Maximum="100" Margin="0,0,0,10" />

            <!-- Discovered Results List -->
            <ListBox x:Name="FoundList"
                     Grid.Row="3"
                     Style="{StaticResource ServerListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />
                            <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VerdictReason}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding LatencyDisplay}"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
                <TextBlock x:Name="StatusLabel"
                           DockPanel.Dock="Left"
                           Text="Готово к запуску (введите AUTO или подсеть вида 192.255.159.0/24)"
                           Style="{StaticResource CaptionMutedStyle}"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Content="Добавить найденные в базу"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnSaveFoundClick" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
