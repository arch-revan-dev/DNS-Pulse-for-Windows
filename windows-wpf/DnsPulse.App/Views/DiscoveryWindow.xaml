<Window x:Class="DnsPulse.App.Views.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подбор и сканер DNS — DNS Pulse"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Подбор, парсинг и сканер /24" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Поиск рабочих Smart-DNS и SNI-прокси 443 по подсетям и открытым источникам" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SubnetInput" Grid.Column="0" Text="AUTO" Padding="10,7" Background="{DynamicResource SecondarySurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" FontFamily="JetBrains Mono, Cascadia Mono" />
                <Button x:Name="ScanBtn" Grid.Column="2" Content="Сканировать" Padding="16,7" Click="OnScanClick" />
                <Button x:Name="SyncFeedsBtn" Grid.Column="4" Content="Синхронизация фидов" Padding="14,7" Click="OnSyncFeedsClick" />
            </Grid>
        </Border>

        <ProgressBar x:Name="ScanProgress" Grid.Row="2" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,10" />

        <ListView x:Name="FoundList" Grid.Row="3" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="6,4" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VerdictReason}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastLatencyMs, StringFormat='{}{0} мс'}" FontFamily="JetBrains Mono, Cascadia Mono" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusLabel" DockPanel.Dock="Left" Text="Готово к запуску (введите AUTO или подсеть вида 192.255.159.0/24)" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Добавить найденные в базу" Padding="16,8" Click="OnSaveFoundClick" />
        </DockPanel>
    </Grid>
</Window>
