<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DnsPulse</AssemblyName>
    <RootNamespace>DnsPulse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Authors>DNS Pulse Open Source Contributors</Authors>
    <Description>Windows 10/11 Smart-DNS, DoH/DoT/SNI-Proxy Diagnostics &amp; Local Tunnel</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\dns_catalog_1000.tsv" Link="assets\dns_catalog_1000.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\..\assets\dns_catalog_1000.tsv" LogicalName="DnsPulse.App.assets.dns_catalog_1000.tsv" />
  </ItemGroup>
</Project>
